---
/**
 * Homepage-only cinematic preloader.
 *
 * The site remains visible by default. A tiny bootstrap in Base.astro opts
 * into this layer only on the homepage and only when motion is allowed.
 */
---

<div
  class="site-preloader"
  id="site-preloader"
  data-site-preloader
  data-phase="idle"
  data-testid="site-preloader"
  role="status"
  aria-label="Loading It's A Keeper Photography"
>
  <span class="site-preloader__sr-only">
    Preparing the photography portfolio…
  </span>

  <div
    class="site-preloader__panel site-preloader__panel--top"
    id="site-preloader-panel-top"
    aria-hidden="true"
  ></div>
  <div
    class="site-preloader__panel site-preloader__panel--bottom"
    id="site-preloader-panel-bottom"
    aria-hidden="true"
  ></div>

  <div class="site-preloader__content" aria-hidden="true">
    <div class="site-preloader__camera-stage" id="site-preloader-camera-stage">
      <div class="site-preloader__camera-float" id="site-preloader-camera-float">
        <svg
          class="site-preloader__camera"
          id="site-preloader-camera"
          data-testid="preloader-camera"
          viewBox="0 0 640 440"
          preserveAspectRatio="xMidYMid meet"
          role="img"
          aria-labelledby="preloader-camera-title preloader-camera-description"
          focusable="false"
        >
          <title id="preloader-camera-title">
            A warm-toned professional camera
          </title>
          <desc id="preloader-camera-description">
            A stylized front-facing mirrorless camera whose lens focuses,
            flashes, and reveals the photography website.
          </desc>

          <defs>
            <radialGradient id="preloader-lens-gradient" cx="36%" cy="30%" r="72%">
              <stop offset="0" stop-color="#f2e8d7" stop-opacity="0.86"></stop>
              <stop offset="0.22" stop-color="#8d5933" stop-opacity="0.9"></stop>
              <stop offset="0.63" stop-color="#493621"></stop>
              <stop offset="1" stop-color="#281e10"></stop>
            </radialGradient>
            <clipPath id="preloader-lens-clip">
              <circle cx="320" cy="246" r="67"></circle>
            </clipPath>
          </defs>

          <g id="camera-body">
            <path
              d="M100 126H536Q576 126 576 166V328Q576 370 534 370H104Q64 370 64 330V164Q64 126 100 126Z"
              fill="#604a31"></path>
            <path
              d="M88 163Q88 148 104 148H538Q552 148 552 164V330Q552 346 536 346H104Q88 346 88 330Z"
              fill="#493621"
              opacity="0.34"></path>
            <path
              d="M480 145H535Q558 145 558 170V324Q558 350 532 350H493Q474 326 474 293V186Q474 159 480 145Z"
              fill="#493621"></path>
            <path
              d="M497 166V326"
              fill="none"
              stroke="#71674e"
              stroke-opacity="0.58"
              stroke-width="2"></path>
            <circle cx="129" cy="174" r="6" fill="#71674e"></circle>
            <rect
              x="112"
              y="194"
              width="52"
              height="8"
              rx="4"
              fill="#281e10"
              opacity="0.52"></rect>
          </g>

          <g id="camera-top">
            <path
              d="M112 139L134 105Q139 96 151 96H230L252 70Q260 59 274 59H348Q362 59 371 70L394 96H493Q508 96 514 109L529 139Z"
              fill="#71674e"></path>
            <rect
              x="282"
              y="52"
              width="58"
              height="12"
              rx="3"
              fill="#281e10"></rect>
            <rect
              x="291"
              y="50"
              width="40"
              height="4"
              rx="2"
              fill="#8d5933"></rect>
            <rect
              x="277"
              y="76"
              width="86"
              height="50"
              rx="9"
              fill="#493621"></rect>
            <rect
              x="288"
              y="84"
              width="64"
              height="32"
              rx="5"
              fill="#281e10"
              stroke="#b6a997"
              stroke-opacity="0.55"
              stroke-width="2"></rect>
            <path
              d="M296 91H332"
              fill="none"
              stroke="#f2e8d7"
              stroke-linecap="round"
              stroke-opacity="0.28"
              stroke-width="2"></path>
          </g>

          <g id="shutter-button">
            <rect
              x="467"
              y="99"
              width="62"
              height="18"
              rx="9"
              fill="#281e10"></rect>
            <ellipse cx="498" cy="99" rx="23" ry="8" fill="#8d5933"></ellipse>
            <ellipse
              cx="492"
              cy="97"
              rx="9"
              ry="2.5"
              fill="#f2e8d7"
              opacity="0.3"></ellipse>
          </g>

          <g id="lens-outer">
            <circle cx="320" cy="246" r="124" fill="#281e10"></circle>
            <circle
              cx="320"
              cy="246"
              r="116"
              fill="none"
              stroke="#8d5933"
              stroke-width="4"></circle>
            <circle
              cx="320"
              cy="246"
              r="110"
              fill="none"
              stroke="#b6a997"
              stroke-opacity="0.26"
              stroke-width="1"></circle>
          </g>

          <g id="lens-mid">
            <circle cx="320" cy="246" r="106" fill="#604a31"></circle>
            <circle cx="320" cy="246" r="98" fill="#493621"></circle>
            <g
              fill="none"
              stroke="#f2e8d7"
              stroke-linecap="round"
              stroke-opacity="0.26"
              stroke-width="3"
            >
              <path d="M320 143V153"></path>
              <path d="M320 339V349"></path>
              <path d="M217 246H227"></path>
              <path d="M413 246H423"></path>
              <path d="M247 173L254 180"></path>
              <path d="M386 312L393 319"></path>
              <path d="M393 173L386 180"></path>
              <path d="M254 312L247 319"></path>
            </g>
          </g>

          <g id="lens-inner">
            <circle cx="320" cy="246" r="88" fill="#281e10"></circle>
            <circle cx="320" cy="246" r="79" fill="#71674e"></circle>
            <circle
              cx="320"
              cy="246"
              r="72"
              fill="none"
              stroke="#f2e8d7"
              stroke-opacity="0.34"
              stroke-width="1"></circle>
          </g>

          <g id="lens-glass">
            <circle
              cx="320"
              cy="246"
              r="67"
              fill="url(#preloader-lens-gradient)"
              stroke="#f2e8d7"
              stroke-opacity="0.38"
              stroke-width="2"></circle>
            <circle
              cx="299"
              cy="224"
              r="16"
              fill="#f2e8d7"
              opacity="0.08"></circle>
          </g>

          <g id="shutter-iris" clip-path="url(#preloader-lens-clip)">
            <g id="iris-top">
              <path
                d="M253 246A67 67 0 0 1 387 246V179H253Z"
                fill="#281e10"
                opacity="0.96"></path>
            </g>
            <g id="iris-bottom">
              <path
                d="M253 246A67 67 0 0 0 387 246V313H253Z"
                fill="#281e10"
                opacity="0.96"></path>
            </g>
          </g>

          <g id="flash-glint" clip-path="url(#preloader-lens-clip)">
            <g transform="rotate(-24 320 246)">
              <rect
                x="218"
                y="239"
                width="180"
                height="12"
                rx="6"
                fill="#f2e8d7"
                opacity="0.64"></rect>
            </g>
          </g>

          <g
            id="viewfinder-frames"
            fill="none"
            stroke="#b6a997"
            stroke-linecap="square"
            stroke-width="2"
          >
            <path d="M48 126V82H92"></path>
            <path d="M548 82H592V126"></path>
            <path d="M48 314V358H92"></path>
            <path d="M548 358H592V314"></path>
          </g>
        </svg>
      </div>
    </div>

  </div>

  <div
    class="site-preloader__flash"
    id="site-preloader-flash"
    data-testid="preloader-flash"
    aria-hidden="true"
  ></div>
</div>

<noscript>
  <style is:global>
    .site-preloader {
      display: none !important;
    }
  </style>
</noscript>

<script>
  import "../scripts/cinematic-preloader";
</script>

<style>
  .site-preloader {
    --site-preloader-flash: #fff8ee;
    --site-preloader-layer: 1000;

    position: fixed;
    z-index: var(--site-preloader-layer);
    inset: 0;
    display: grid;
    place-items: center;
    contain: strict;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(html.is-preloading) .site-preloader {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    animation: site-preloader-emergency-dismiss 240ms
      cubic-bezier(0.22, 1, 0.36, 1) 3.8s forwards;
  }

  :global(html.is-preloading.is-preloader-qa) .site-preloader {
    animation: none;
  }

  :global(html.is-preloading) {
    overflow: hidden;
    overscroll-behavior: none;
    scrollbar-gutter: stable;
  }

  .site-preloader__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .site-preloader__panel {
    position: absolute;
    z-index: 0;
    left: 0;
    width: 100%;
    height: calc(50% + 1px);
    background-color: var(--color-canvas);
    background-image: radial-gradient(
      circle at 50% 50%,
      var(--color-surface-decorative) 0,
      var(--color-canvas) 68%
    );
    background-repeat: no-repeat;
    background-size: 100vw 100vh;
    will-change: transform;
  }

  .site-preloader__panel--top {
    top: 0;
    background-position: center top;
    border-bottom: var(--border-hairline) solid rgb(182 169 151 / 10%);
  }

  .site-preloader__panel--bottom {
    bottom: 0;
    background-position: center bottom;
    border-top: var(--border-hairline) solid rgb(182 169 151 / 10%);
  }

  .site-preloader__content {
    position: relative;
    z-index: 2;
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    pointer-events: none;
  }

  .site-preloader__camera-stage,
  .site-preloader__camera-float {
    position: absolute;
    display: grid;
    place-items: center;
    transform-origin: center;
    will-change: transform, opacity;
  }

  .site-preloader__camera-stage {
    width: min(90vw, 34rem);
    opacity: 0;
    transform: translate3d(0, 0.5rem, 0) scale(0.85);
  }

  .site-preloader__camera-float {
    width: 100%;
  }

  .site-preloader__camera {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .site-preloader__camera g {
    transform-box: view-box;
  }

  #camera-body {
    transform-origin: 320px 248px;
  }

  #camera-top {
    transform-origin: 320px 126px;
  }

  #lens-outer,
  #lens-mid,
  #lens-inner,
  #lens-glass,
  #shutter-iris {
    transform-origin: 320px 246px;
    will-change: transform, opacity;
  }

  #shutter-button {
    transform-origin: 500px 104px;
    will-change: transform;
  }

  #flash-glint {
    opacity: 0;
    transform-origin: 320px 246px;
    will-change: transform, opacity;
  }

  #viewfinder-frames {
    opacity: 0;
    transform-origin: 320px 220px;
    will-change: transform, opacity;
  }

  #iris-top {
    transform: translate3d(0, -4.5rem, 0);
    transform-origin: 320px 246px;
    will-change: transform;
  }

  #iris-bottom {
    transform: translate3d(0, 4.5rem, 0);
    transform-origin: 320px 246px;
    will-change: transform;
  }

  .site-preloader__flash {
    position: absolute;
    z-index: 5;
    inset: 0;
    opacity: 0;
    background: var(--site-preloader-flash);
    pointer-events: none;
    will-change: opacity;
  }

  @keyframes site-preloader-emergency-dismiss {
    to {
      opacity: 0;
    }
  }

  @media (max-width: 48rem) {
    .site-preloader__camera-stage {
      width: min(88vw, 27rem);
    }

  }

  @media (max-width: 26.25rem) {
    .site-preloader__camera-stage {
      width: min(92vw, 22rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-preloader {
      display: none !important;
    }
  }
</style>
