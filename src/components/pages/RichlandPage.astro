---
import type { EditorialPageData, PageSection } from "../../content/page-types";
import Picture from "../Picture.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/richland-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

const { page } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) throw new Error(`Richland page is missing the required section: ${id}`);
  return section;
};

const introduction = requireSection("i-live-here");
const spots = requireSection("richland-spots");
const directory = requireSection("richland-session-directory");
const recent = requireSection("recent-richland-sessions");
const questions = requireSection("richland-questions");

const spotItems = spots.items || [];
const serviceItems = directory.items || [];
const faqItems = questions.items || [];
const featuredQuestionIndex = faqItems.length > 1 ? 1 : 0;
const featuredQuestion = faqItems[featuredQuestionIndex];
const ledgerQuestions = faqItems
  .map((item, index) => ({ item, index }))
  .filter(({ index }) => index !== featuredQuestionIndex);
const guideLink = spots.links?.find((link) =>
  link.href.includes("family-photo-locations-tri-cities"),
);

const faqSchema = faqItems
  .filter((item) => item.heading && item.paragraphs?.length)
  .map((item) => ({
    "@type": "Question",
    name: item.heading,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.paragraphs?.join(" "),
    },
  }));

const introArch = introduction.image || "/uploads/family-with-baby-golden-hour-embrace-tricities.jpg";
const introPrint = introduction.secondaryImage || "/uploads/investment-lisa-photographing-outdoors-tricities.jpg";
const serviceRear = directory.image || "/uploads/extended-family-embrace-tricities.jpg";
const serviceFront = directory.secondaryImage || "/uploads/headshot-formal-portrait-stairs-tricities.jpg";
const finalImage = page.finalCta?.image || "/uploads/family-newborn-sunset-tricities.jpg";
---

<article
  class="richland-page"
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
>
  <EditorialHero
    pageKey="richland"
    titleId="richland-hero-title"
    heading={page.hero.heading}
    headingLines={["Your Richland, WA", "Photographer"]}
    scriptLine={page.hero.scriptLine || "right here in Richland"}
    intro={page.hero.intro}
    backgroundImage={page.hero.image}
    backgroundAlt={page.hero.imageAlt}
    backgroundPosition="50% 53%"
    mobileBackgroundPosition="53% 50%"
    leftPrint={{
      src: "/uploads/family-newborn-sunset-tricities.jpg",
      objectPosition: "50% 44%",
    }}
    rightPrint={{
      src: page.hero.secondaryImage || "/uploads/headshot-warm-portrait-tricities.jpg",
      objectPosition: "50% 42%",
    }}
    buttonLabel="Plan Your Richland Session"
    buttonTargetId="richland-final"
    paperEdgeColor="var(--color-weathered-sand)"
  />

  <section
    class:list={["richland-intro", `tone-${introduction.tone}`]}
    aria-labelledby={`${introduction.id}-title`}
  >
    <div class="richland-intro__line richland-intro__line--horizontal" aria-hidden="true"></div>
    <div class="richland-shell richland-intro__inner">
      <div class="richland-intro__media">
        <span class="richland-intro__line richland-intro__line--vertical" aria-hidden="true"></span>
        <figure class="richland-intro__arch">
          <Picture
            src={introArch}
            alt={introduction.imageAlt || "Family embracing outdoors during a golden-hour portrait session"}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 74vw, (max-width: 1050px) 41vw, 30rem"
            imgClass="photo--editorial"
          />
        </figure>

        <figure class="richland-print richland-intro__print">
          <span class="richland-tape richland-tape--intro" aria-hidden="true"></span>
          <Picture
            src={introPrint}
            alt={introduction.secondaryImageAlt || "Lisa photographing a portrait session outdoors"}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 48vw, (max-width: 1050px) 26vw, 19rem"
            imgClass="photo--editorial"
          />
        </figure>
      </div>

      <div class="richland-intro__copy">
        {introduction.eyebrow && <p class="richland-eyebrow">{introduction.eyebrow}</p>}
        <h2 id={`${introduction.id}-title`}>{introduction.heading}</h2>
        <div class="richland-prose">
          {introduction.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section
    class:list={["richland-spots", `tone-${spots.tone}`]}
    aria-labelledby={`${spots.id}-title`}
  >
    <div class="richland-shell">
      <header class="richland-spots__heading">
        {spots.eyebrow && <p class="richland-eyebrow">{spots.eyebrow}</p>}
        <h2 id={`${spots.id}-title`}>{spots.heading}</h2>
      </header>

      {spotItems.length > 0 && (
        <div class="richland-spots__composition">
          {spotItems[0]?.image && (
            <figure class="richland-print richland-spots__photo richland-spots__photo--left">
              <span class="richland-tape richland-tape--left" aria-hidden="true"></span>
              <Picture
                src={spotItems[0].image}
                alt={spotItems[0].imageAlt || "Portrait beside the river in warm evening light"}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) 48vw, (max-width: 1050px) 29vw, 22rem"
                imgClass="photo--editorial"
              />
            </figure>
          )}

          {spotItems[1]?.image && (
            <figure class="richland-spots__photo richland-spots__photo--arch">
              <Picture
                src={spotItems[1].image}
                alt={spotItems[1].imageAlt || "Portrait in an open outdoor setting"}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) 68vw, (max-width: 1050px) 38vw, 29rem"
                imgClass="photo--editorial"
              />
            </figure>
          )}

          {spotItems[2]?.image && (
            <figure class="richland-print richland-spots__photo richland-spots__photo--right">
              <Picture
                src={spotItems[2].image}
                alt={spotItems[2].imageAlt || "Couple sharing a quiet moment during an outdoor portrait session"}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) 44vw, (max-width: 1050px) 27vw, 20rem"
                imgClass="photo--editorial"
              />
            </figure>
          )}
        </div>
      )}

      {/* CONTENT PENDING: [VALIDAR CON LISA: confirmar que estos son SUS spots reales y añadir 1–2 detalles de primera mano por locación (p. ej. "la luz cae detrás de X a las Y"). Ese detalle es lo que ninguna otra página puede copiar.] */}
      {spotItems.length > 0 && (
        <ol class="richland-spots__ledger">
          {spotItems.map((item, index) => (
            <li>
              <span class="richland-ledger-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              {item.heading && <h3>{item.heading}</h3>}
              {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            </li>
          ))}
        </ol>
      )}

      {guideLink && (
        <a class="richland-text-link richland-spots__guide" href={guideLink.href}>
          {guideLink.label}
        </a>
      )}
    </div>
  </section>

  <section
    class:list={["richland-services", `tone-${directory.tone}`]}
    aria-labelledby={`${directory.id}-title`}
  >
    <div class="richland-shell richland-services__inner">
      <div class="richland-services__copy">
        {directory.eyebrow && <p class="richland-eyebrow">{directory.eyebrow}</p>}
        <h2 id={`${directory.id}-title`} aria-label={directory.heading}>
          <span aria-hidden="true">Sessions I</span>
          <span aria-hidden="true">Photograph</span>
          <span aria-hidden="true">in Richland</span>
        </h2>

        {serviceItems.length > 0 && (
          <ol class="richland-services__list">
            {serviceItems.map((item, index) => {
              const link = item.links?.[0];
              return (
                <li>
                  <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  {link ? <a href={link.href}>{item.heading}</a> : <strong>{item.heading}</strong>}
                </li>
              );
            })}
          </ol>
        )}
      </div>

      <div class="richland-services__media">
        <span class="richland-services__rule" aria-hidden="true"></span>
        <figure class="richland-services__photo richland-services__photo--rear">
          <Picture
            src={serviceRear}
            alt={directory.imageAlt || "Extended family gathered closely for a portrait"}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 78vw, (max-width: 1050px) 48vw, 34rem"
            imgClass="photo--editorial"
          />
        </figure>

        <figure class="richland-print richland-services__photo richland-services__photo--front">
          <span class="richland-tape richland-tape--service" aria-hidden="true"></span>
          <Picture
            src={serviceFront}
            alt={directory.secondaryImageAlt || "Professional portrait photographed on location"}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 43vw, (max-width: 1050px) 25vw, 18rem"
            imgClass="photo--editorial"
          />
        </figure>
      </div>
    </div>
  </section>

  {/* CONTENT PENDING: [PENDIENTE: 6–10 imágenes de sesiones reales en Richland, cada una con alt text que nombre la locación]. The claimed Recent Richland Sessions gallery remains unrendered until the local media is supplied. */}
  <div class:list={["richland-interlude", `tone-${recent.tone}`]} aria-hidden="true">
    <div class="richland-shell richland-interlude__contact-sheet">
      <figure class="richland-print richland-interlude__print richland-interlude__print--one">
        <Picture
          src="/uploads/extended-family-embrace-tricities.jpg"
          alt=""
          loading="lazy"
          decoding="async"
          responsiveSrcset
          sizes="(max-width: 767px) 47vw, (max-width: 1050px) 32vw, 23rem"
          imgClass="photo--editorial"
        />
      </figure>
      <figure class="richland-interlude__arch">
        <Picture
          src="/uploads/headshot-warm-portrait-tricities.jpg"
          alt=""
          loading="lazy"
          decoding="async"
          responsiveSrcset
          sizes="(max-width: 767px) 62vw, (max-width: 1050px) 36vw, 26rem"
          imgClass="photo--editorial"
        />
      </figure>
      <figure class="richland-print richland-interlude__print richland-interlude__print--three">
        <span class="richland-tape richland-tape--interlude" aria-hidden="true"></span>
        <Picture
          src="/uploads/family-newborn-sunset-tricities.jpg"
          alt=""
          loading="lazy"
          decoding="async"
          responsiveSrcset
          sizes="(max-width: 767px) 44vw, (max-width: 1050px) 30vw, 21rem"
          imgClass="photo--editorial"
        />
      </figure>
    </div>
  </div>

  <section
    class:list={["richland-faq", `tone-${questions.tone}`]}
    aria-labelledby={`${questions.id}-title`}
  >
    <div class="richland-shell richland-faq__inner">
      <div class="richland-faq__questions">
        <header>
          {questions.eyebrow && <p class="richland-eyebrow">{questions.eyebrow}</p>}
          <h2 id={`${questions.id}-title`}>{questions.heading}</h2>
        </header>

        {/* CONTENT PENDING [Do you have a studio in Richland?]: [VALIDAR: formato newborn] */}
        {/* CONTENT PENDING [Do you travel outside Richland?]: [VALIDAR: política de viaje — Q2/Q53] */}
        {ledgerQuestions.length > 0 && (
          <div class="richland-faq__ledger">
            {ledgerQuestions.map(({ item, index }) => (
              <details open={index === 0}>
                <summary>
                  <span class="richland-faq__number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  {item.heading && <h3>{item.heading}</h3>}
                  <span class="richland-faq__mark" aria-hidden="true"></span>
                </summary>
                <div class="richland-faq__answer">
                  {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </details>
            ))}
          </div>
        )}
      </div>

      {featuredQuestion && (
        <article class="richland-faq__note" aria-labelledby="richland-featured-question">
          <Picture
            src={questions.image || "/uploads/investment-final-torn-paper-pin.png"}
            alt=""
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 88vw, (max-width: 1050px) 44vw, 27rem"
            pictureClass="richland-faq__paper-frame"
            imgClass="richland-faq__paper-art"
          />
          <div class="richland-faq__note-copy">
            <span class="richland-faq__note-number" aria-hidden="true">
              {String(featuredQuestionIndex + 1).padStart(2, "0")}
            </span>
            <h3 id="richland-featured-question">{featuredQuestion.heading}</h3>
            {featuredQuestion.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>
      )}
    </div>
  </section>

  {page.finalCta && (
    <section
      id="richland-final"
      class:list={["richland-final", `tone-${page.finalCta.tone}`]}
      aria-labelledby="richland-final-title"
      tabindex="-1"
    >
      <div class="richland-final__background" aria-hidden="true">
        <Picture
          src={finalImage}
          alt=""
          loading="lazy"
          decoding="async"
          responsiveSrcset
          sizes="100vw"
          imgClass="richland-final__background-image"
        />
        <div class="richland-final__wash"></div>
      </div>
      <div class="richland-shell richland-final__inner">
        <div class="richland-final__frame">
          <p class="richland-final__script" aria-hidden="true">find your light</p>
          <h2 id="richland-final-title">{page.finalCta.heading}</h2>
          {page.finalCta.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {page.finalCta.link && (
            <a class="outline-button" href={page.finalCta.link.href}>
              {page.finalCta.link.label}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {faqSchema.length > 0 && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqSchema,
      })}
    />
  )}
</article>
