---
import type {
  EditorialPageData,
  PageLink,
  PageSection,
} from "../../content/page-types";
import { tinaField } from "@tinacms/astro/tina-field";
import Picture from "../Picture.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/richland-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

interface LinkedPart {
  text: string;
  link?: PageLink;
}

const { page } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) throw new Error(`Richland page is missing the required section: ${id}`);
  return section;
};

const introduction = requireSection("i-live-here");
const light = requireSection("richland-light");
const directory = requireSection("richland-session-directory");
const planning = requireSection("richland-planning");
const questions = requireSection("richland-questions");
const recent = page.sections.find((section) => section.id === "recent-richland-sessions");

const serviceItems = directory.items || [];
const faqItems = (questions.items || []).filter(
  (item) => item.heading && item.paragraphs?.length,
);
const recentItems = recent?.items || [];
const hasRecentGallery = recentItems.length > 0;
const recentImagePaths = recentItems
  .map((item) => item.image?.trim())
  .filter((image): image is string => Boolean(image));

if (
  hasRecentGallery &&
  (
    recentItems.length !== 10 ||
    !recent?.heading?.trim() ||
    recentItems.some(
      (item) =>
        !item.heading?.trim() ||
        !item.image?.trim() ||
        !item.imageAlt?.trim() ||
        Boolean(item.links?.length),
    ) ||
    new Set(recentImagePaths).size !== recentItems.length
  )
) {
  throw new Error(
    "Richland recent gallery requires exactly ten complete items with unique images and no links",
  );
}

const headingLines = (heading: string): string[] => {
  const words = heading.trim().split(/\s+/);
  const lastWord = words.at(-1);
  if (words.length > 1 && lastWord?.toLowerCase() === "photographer") {
    return [words.slice(0, -1).join(" "), lastWord];
  }
  return [heading];
};

const linkedParts = (paragraph: string, links: PageLink[] = []): LinkedPart[] => {
  const available = links.filter((link) => link.label && paragraph.includes(link.label));
  if (!available.length) return [{ text: paragraph }];

  const parts: LinkedPart[] = [];
  let cursor = 0;

  while (cursor < paragraph.length) {
    const next = available
      .map((link) => ({ link, index: paragraph.indexOf(link.label, cursor) }))
      .filter(({ index }) => index >= cursor)
      .sort((a, b) => a.index - b.index)[0];

    if (!next) {
      parts.push({ text: paragraph.slice(cursor) });
      break;
    }

    if (next.index > cursor) {
      parts.push({ text: paragraph.slice(cursor, next.index) });
    }
    parts.push({ text: next.link.label, link: next.link });
    cursor = next.index + next.link.label.length;
  }

  return parts;
};

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  name: item.heading,
  acceptedAnswer: {
    "@type": "Answer",
    text: item.paragraphs?.join(" "),
  },
}));
---

<article
  class="richland-page"
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
  data-tina-field={tinaField(page)}
>
  <!-- Direction contract: editorial heirloom; persuade + read; Richland residence, local light knowledge, and an asymmetrical photographic rhythm. -->
  <EditorialHero
    pageKey="richland"
    titleId="richland-hero-title"
    heading={page.hero.heading}
    headingLines={headingLines(page.hero.heading)}
    scriptLine={page.hero.scriptLine || ""}
    intro={page.hero.intro}
    buttonLabel={page.hero.links?.[0]?.label}
    buttonTargetId="richland-final"
    backgroundImage={page.hero.image}
    backgroundAlt={page.hero.imageAlt}
    backgroundPosition="50% 52%"
    mobileBackgroundPosition="52% 50%"
    rightPrint={page.hero.secondaryImage
      ? {
          src: page.hero.secondaryImage,
          objectPosition: "50% 44%",
        }
      : undefined}
    paperEdgeColor="var(--color-weathered-sand)"
    dataTinaField={tinaField(page, "hero")}
  />

  <section
    id={introduction.id}
    class:list={["richland-residence", `tone-${introduction.tone}`]}
    aria-labelledby={`${introduction.id}-title`}
    data-tina-field={tinaField(introduction)}
  >
    <div class="richland-shell richland-residence__grid">
      <div class="richland-residence__media">
        {introduction.image && (
          <figure class="richland-residence__arch">
            <Picture
              src={introduction.image}
              alt={introduction.imageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 78vw, (max-width: 1050px) 43vw, 31rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}

        {introduction.secondaryImage && (
          <figure class="richland-photo-frame richland-residence__print">
            <Picture
              src={introduction.secondaryImage}
              alt={introduction.secondaryImageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 48vw, (max-width: 1050px) 27vw, 19rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}

        {(introduction.image || introduction.secondaryImage) && (
          <span class="richland-media-rule richland-residence__rule" aria-hidden="true"></span>
        )}
      </div>

      <div class="richland-residence__copy">
        {introduction.eyebrow && <p class="richland-eyebrow">{introduction.eyebrow}</p>}
        <h2 id={`${introduction.id}-title`}>{introduction.heading}</h2>
        <div class="richland-prose">
          {introduction.paragraphs?.map((paragraph) => (
            <p>
              {linkedParts(paragraph, introduction.links).map((part) =>
                part.link ? (
                  <a
                    href={part.link.href}
                    target={part.link.external ? "_blank" : undefined}
                    rel={part.link.external ? "noreferrer" : undefined}
                  >
                    {part.text}
                  </a>
                ) : (
                  <Fragment>{part.text}</Fragment>
                ),
              )}
            </p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section
    id={light.id}
    class:list={["richland-light", `tone-${light.tone}`]}
    aria-labelledby={`${light.id}-title`}
    data-tina-field={tinaField(light)}
  >
    <div class="richland-shell">
      <header class="richland-light__header">
        {light.eyebrow && <p class="richland-eyebrow">{light.eyebrow}</p>}
        <h2 id={`${light.id}-title`}>{light.heading}</h2>
      </header>

      <div class="richland-light__layout">
        <div class="richland-prose richland-light__copy">
          {light.paragraphs?.map((paragraph) => (
            <p>
              {linkedParts(paragraph, light.links).map((part) =>
                part.link ? (
                  <a
                    href={part.link.href}
                    target={part.link.external ? "_blank" : undefined}
                    rel={part.link.external ? "noreferrer" : undefined}
                  >
                    {part.text}
                  </a>
                ) : (
                  <Fragment>{part.text}</Fragment>
                ),
              )}
            </p>
          ))}
        </div>

        <div class="richland-light__media">
          {light.image && (
            <figure class="richland-light__panorama">
              <Picture
                src={light.image}
                alt={light.imageAlt || ""}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) 100vw, (max-width: 1050px) 58vw, 50rem"
                imgClass="photo--editorial"
              />
            </figure>
          )}

          {light.secondaryImage && (
            <figure class="richland-light__portrait">
              <Picture
                src={light.secondaryImage}
                alt={light.secondaryImageAlt || ""}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) 64vw, (max-width: 1050px) 31vw, 22rem"
                imgClass="photo--editorial"
              />
            </figure>
          )}

          {(light.image || light.secondaryImage) && (
            <span class="richland-media-rule richland-light__rule" aria-hidden="true"></span>
          )}
        </div>
      </div>
    </div>
  </section>

  <section
    id={directory.id}
    class:list={["richland-directory", `tone-${directory.tone}`]}
    aria-labelledby={`${directory.id}-title`}
    data-tina-field={tinaField(directory)}
  >
    <div class="richland-shell">
      <header class="richland-directory__header">
        <div>
          {directory.eyebrow && <p class="richland-eyebrow">{directory.eyebrow}</p>}
          <h2 id={`${directory.id}-title`}>{directory.heading}</h2>
        </div>
        {directory.intro && <p class="richland-directory__intro">{directory.intro}</p>}
      </header>

      {serviceItems.length > 0 && (
        <ol class="richland-directory__list">
          {serviceItems.map((item, index) => {
            const link = item.links?.[0];
            const label = item.heading || link?.label;
            const Row = link ? "a" : "div";

            return (
              <li data-tina-field={tinaField(item)}>
                <Row
                  class:list={[
                    "richland-directory__row",
                    link && "richland-directory__link",
                  ]}
                  href={link?.href}
                >
                  <span class="richland-directory__number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="richland-directory__name">
                    <strong>{label}</strong>
                    {link && (
                      <span class="richland-directory__arrow" aria-hidden="true">
                        <svg
                          viewBox="0 0 24 24"
                          width="20"
                          height="20"
                          fill="none"
                          focusable="false"
                        >
                          <path
                            d="M7 17 17 7M8 7h9v9"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          ></path>
                        </svg>
                      </span>
                    )}
                  </span>
                  {item.detail && (
                    <span class="richland-directory__detail">{item.detail}</span>
                  )}
                </Row>
              </li>
            );
          })}
        </ol>
      )}

      {(directory.image || directory.secondaryImage) && (
        <div class="richland-directory__media">
          {directory.image && (
            <figure class="richland-directory__landscape">
              <Picture
                src={directory.image}
                alt={directory.imageAlt || ""}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) 100vw, (max-width: 1050px) 58vw, 48rem"
                imgClass="photo--editorial"
              />
            </figure>
          )}
          {directory.secondaryImage && (
            <figure class="richland-photo-frame richland-directory__portrait">
              <Picture
                src={directory.secondaryImage}
                alt={directory.secondaryImageAlt || ""}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) 52vw, (max-width: 1050px) 28vw, 20rem"
                imgClass="photo--editorial"
              />
            </figure>
          )}
        </div>
      )}
    </div>
  </section>

  {/* A nonempty gallery is validated above before any item reaches this contact sheet. */}
  {recent && hasRecentGallery && (
    <section
      id={recent.id}
      class:list={["richland-recent", `tone-${recent.tone}`]}
      aria-labelledby={`${recent.id}-title`}
      data-tina-field={tinaField(recent)}
    >
      <div class="richland-shell">
        <header class="richland-recent__header">
          {recent.eyebrow && <p class="richland-eyebrow">{recent.eyebrow}</p>}
          <h2 id={`${recent.id}-title`}>{recent.heading}</h2>
          {recent.intro && <p>{recent.intro}</p>}
        </header>
        <div class="richland-recent__gallery">
          {recentItems.map((item, index) => (
            <figure
              class:list={[
                "richland-recent__photo",
                `richland-recent__photo--${(index % 4) + 1}`,
                index === 4 && "richland-recent__photo--landscape",
              ]}
              data-tina-field={tinaField(item)}
            >
              <Picture
                src={item.image!}
                alt={item.imageAlt!}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1050px) 46vw, 21rem"
                imgClass="photo--editorial"
              />
              <figcaption>{item.heading}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section
    id={planning.id}
    class:list={["richland-planning", `tone-${planning.tone}`]}
    aria-labelledby={`${planning.id}-title`}
    data-tina-field={tinaField(planning)}
  >
    <div class="richland-shell richland-planning__grid">
      <div class="richland-planning__copy">
        {planning.eyebrow && <p class="richland-eyebrow">{planning.eyebrow}</p>}
        <h2 id={`${planning.id}-title`}>{planning.heading}</h2>
        <div class="richland-prose">
          {planning.paragraphs?.map((paragraph) => (
            <p>
              {linkedParts(paragraph, planning.links).map((part) =>
                part.link ? (
                  <a
                    href={part.link.href}
                    target={part.link.external ? "_blank" : undefined}
                    rel={part.link.external ? "noreferrer" : undefined}
                  >
                    {part.text}
                  </a>
                ) : (
                  <Fragment>{part.text}</Fragment>
                ),
              )}
            </p>
          ))}
        </div>
      </div>

      <div class="richland-planning__media">
        {planning.image && (
          <figure class="richland-planning__primary">
            <Picture
              src={planning.image}
              alt={planning.imageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 72vw, (max-width: 1050px) 40vw, 28rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}
        {planning.secondaryImage && (
          <figure class="richland-photo-frame richland-planning__secondary">
            <Picture
              src={planning.secondaryImage}
              alt={planning.secondaryImageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 54vw, (max-width: 1050px) 29vw, 21rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}
        {(planning.image || planning.secondaryImage) && (
          <span class="richland-media-rule richland-planning__rule" aria-hidden="true"></span>
        )}
      </div>
    </div>
  </section>

  <section
    id={questions.id}
    class:list={["richland-faq", `tone-${questions.tone}`]}
    aria-labelledby={`${questions.id}-title`}
    data-tina-field={tinaField(questions)}
  >
    <div class="richland-shell richland-faq__grid">
      <header class="richland-faq__header">
        {questions.eyebrow && <p class="richland-eyebrow">{questions.eyebrow}</p>}
        <h2 id={`${questions.id}-title`}>{questions.heading}</h2>
        {questions.intro && <p>{questions.intro}</p>}
      </header>

      {faqItems.length > 0 && (
        <div class="richland-faq__list">
          {faqItems.map((item, index) => (
            <details
              open={index === 0}
              data-tina-field={tinaField(item)}
            >
              <summary>
                <span class="richland-faq__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="richland-faq__question" role="heading" aria-level="3">
                  {item.heading}
                </span>
                <span class="richland-faq__mark" aria-hidden="true"></span>
              </summary>
              <div class="richland-faq__answer">
                {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </details>
          ))}
        </div>
      )}
    </div>
  </section>

  {page.finalCta && (
    <section
      id="richland-final"
      class:list={["richland-final", `tone-${page.finalCta.tone}`]}
      aria-labelledby="richland-final-title"
      tabindex="-1"
      data-tina-field={tinaField(page, "finalCta")}
    >
      {page.finalCta.image && (
        <div class="richland-final__background" aria-hidden="true">
          <Picture
            src={page.finalCta.image}
            alt=""
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="100vw"
            imgClass="richland-final__background-image"
          />
          <span class="richland-final__wash"></span>
        </div>
      )}
      <div class="richland-shell richland-final__inner">
        <div class="richland-final__frame">
          {page.finalCta.eyebrow && <p class="richland-eyebrow">{page.finalCta.eyebrow}</p>}
          <h2 id="richland-final-title">{page.finalCta.heading}</h2>
          {page.finalCta.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {page.finalCta.link && (
            <a class="outline-button" href={page.finalCta.link.href}>
              {page.finalCta.link.label}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {faqSchema.length > 0 && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqSchema,
      })}
    />
  )}
</article>
