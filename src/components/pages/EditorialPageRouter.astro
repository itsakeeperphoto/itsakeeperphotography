---
import type { EditorialPageData } from "../../content/page-types";
import AboutPage from "./AboutPage.astro";
import BrandingHeadshotsArticlePage from "./BrandingHeadshotsArticlePage.astro";
import BrandingPage from "./BrandingPage.astro";
import ContentPage from "./ContentPage.astro";
import ContactPage from "./ContactPage.astro";
import FamilyPage from "./FamilyPage.astro";
import HeadshotPage from "./HeadshotPage.astro";
import InvestmentPage from "./InvestmentPage.astro";
import JournalPage from "./JournalPage.astro";
import KennewickPage from "./KennewickPage.astro";
import NewbornComparisonPage from "./NewbornComparisonPage.astro";
import NewbornPage from "./NewbornPage.astro";
import PascoPage from "./PascoPage.astro";
import RichlandPage from "./RichlandPage.astro";
import ReviewsPage from "./ReviewsPage.astro";
import SeniorPage from "./SeniorPage.astro";
import SeniorTimingPage from "./SeniorTimingPage.astro";
import ThankYouPage from "./ThankYouPage.astro";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
  kindWords?: any;
  testimonials?: any[];
  journalPages?: any[];
  journalData?: any;
}

const props = Astro.props;
const isAboutPage = props.page.route === "/about/";
const isBrandingPage =
  props.page.route === "/branding-photographer-tri-cities-wa/";
const isBrandingHeadshotsArticlePage =
  props.page.route === "/journal/branding-photos-vs-headshots/";
const isContactPage = props.page.route === "/contact/";
const isFamilyPage = props.page.route === "/family-photographer-tri-cities-wa/";
const isHeadshotPage = props.page.route === "/headshot-photographer-tri-cities-wa/";
const isInvestmentPage = props.page.route === "/investment/";
const isJournalPage = props.page.route === "/journal/";
const isKennewickPage = props.page.route === "/kennewick-wa-photographer/";
const isNewbornComparisonPage =
  props.page.route === "/journal/in-home-vs-studio-newborn-photography/";
const isNewbornPage = props.page.route === "/newborn-photographer-tri-cities-wa/";
const isPascoPage = props.page.route === "/pasco-wa-photographer/";
const isRichlandPage = props.page.route === "/richland-wa-photographer/";
const isReviewsPage = props.page.route === "/reviews/";
const isSeniorPage = props.page.route === "/senior-photographer-tri-cities-wa/";
const isSeniorTimingPage =
  props.page.route === "/journal/when-to-book-senior-pictures-tri-cities/";
const isThankYouPage = props.page.route === "/thank-you/";
---

{isAboutPage
  ? <AboutPage {...props} />
  : isBrandingHeadshotsArticlePage
    ? <BrandingHeadshotsArticlePage {...props} />
  : isBrandingPage
    ? <BrandingPage {...props} />
  : isContactPage
    ? <ContactPage {...props} />
  : isFamilyPage
    ? <FamilyPage {...props} />
  : isHeadshotPage
    ? <HeadshotPage {...props} />
  : isInvestmentPage
    ? <InvestmentPage {...props} />
  : isJournalPage
    ? <JournalPage {...props} />
  : isKennewickPage
    ? <KennewickPage {...props} />
  : isNewbornComparisonPage
    ? <NewbornComparisonPage {...props} />
  : isNewbornPage
    ? <NewbornPage {...props} />
  : isPascoPage
    ? <PascoPage {...props} />
  : isRichlandPage
    ? <RichlandPage {...props} />
  : isReviewsPage
    ? <ReviewsPage {...props} />
  : isSeniorPage
    ? <SeniorPage {...props} />
  : isSeniorTimingPage
    ? <SeniorTimingPage {...props} />
  : isThankYouPage
    ? <ThankYouPage {...props} />
    : <ContentPage {...props} />}
