---
import type { EditorialPageData, PageLink, PageSection } from "../../content/page-types";
import Picture from "../Picture.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/senior-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

const { page } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) throw new Error(`Senior page is missing the required section: ${id}`);
  return section;
};

const yearOnly = requireSection("this-year-only-happens-once");
const photogenic = requireSection("not-photogenic");
const locations = requireSection("several-locations-one-evening");
const planning = requireSection("how-we-plan-yours");
const parents = requireSection("for-parents");
const booking = requireSection("when-to-book");
const questions = requireSection("senior-picture-questions");

const heroSideImage = "/uploads/spring-portrait-blossoms-tricities.jpg";
const parentRearImage = "/uploads/autumn-senior-portrait-tricities.jpg";
const finalBackgroundImage = "/uploads/senior-riverside-golden-hour-tricities.jpg";
const [heroHeadingLead, heroHeadingTail] = page.hero.heading.split(" in ");
const heroHeadingLines = [
  heroHeadingLead,
  ...(heroHeadingTail ? [`in ${heroHeadingTail}`] : []),
];

const aboutPhrase = "twenty years in one town";
const latePhrase = "you've left it too late";
const investmentPhrases = ["we sit down together", "in-person viewing"];
const linkedParagraph = (paragraph: string, phrase: string, link?: PageLink) => {
  const start = link?.href && paragraph.indexOf(phrase);
  return start !== undefined && start >= 0
    ? {
        before: paragraph.slice(0, start),
        linked: phrase,
        after: paragraph.slice(start + phrase.length),
        href: link.href,
      }
    : undefined;
};
const parentAboutLink = parents.links?.find((link) => link.href === "/about/");
const bookingArticleLink = booking.links?.find((link) =>
  link.href.includes("when-to-book-senior-pictures"),
);
const investmentLink = questions.items
  ?.flatMap((item) => item.links || [])
  .find((link) => link.href === "/investment/");
const visibleQuestions = questions.items || [];

const faqSchema = visibleQuestions
  .filter((item) => item.heading && item.paragraphs?.length)
  .map((item) => ({
    "@type": "Question",
    name: item.heading,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.paragraphs?.join(" "),
    },
  }));
---

<article
  class="senior-page"
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
>
  <EditorialHero
    pageKey="senior"
    titleId="senior-hero-title"
    heading={page.hero.heading}
    headingLines={heroHeadingLines}
    scriptLine={page.hero.scriptLine || "this year"}
    intro={page.hero.intro}
    links={page.hero.links}
    backgroundImage={page.hero.image}
    backgroundAlt={page.hero.imageAlt}
    backgroundPosition="54% 50%"
    mobileBackgroundPosition="55% 50%"
    leftPrint={{ src: heroSideImage, objectPosition: "50% 45%" }}
    rightPrint={{ src: page.hero.secondaryImage, objectPosition: "50% 48%" }}
    paperEdgeColor="var(--color-weathered-sand)"
  />

  <section class:list={["senior-year", `tone-${yearOnly.tone}`]} aria-labelledby={`${yearOnly.id}-title`}>
    <div class="senior-year__rule" aria-hidden="true"></div>
    <div class="senior-shell senior-year__inner">
      {yearOnly.image && (
        <figure class="senior-year__arch">
          <Picture
            src={yearOnly.image}
            alt={yearOnly.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) min(82vw, 26rem), (max-width: 1050px) 35vw, 31rem"
            imgClass="photo--editorial"
          />
        </figure>
      )}
      <div class="senior-year__copy">
        {yearOnly.eyebrow && <p class="senior-eyebrow">{yearOnly.eyebrow}</p>}
        <h2 id={`${yearOnly.id}-title`}>{yearOnly.heading}</h2>
        <div class="senior-prose">
          {yearOnly.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class:list={["senior-confidence", `tone-${photogenic.tone}`]} aria-labelledby={`${photogenic.id}-title`}>
    <div class="senior-shell senior-confidence__inner">
      <div class="senior-confidence__copy">
        {photogenic.eyebrow && <p class="senior-eyebrow">{photogenic.eyebrow}</p>}
        <h2 id={`${photogenic.id}-title`}>{photogenic.heading}</h2>
        <div class="senior-prose">
          {photogenic.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      {photogenic.image && (
        <div class="senior-confidence__media">
          <figure class="senior-print senior-confidence__primary">
            <span class="senior-tape senior-tape--top" aria-hidden="true"></span>
            <Picture src={photogenic.image} alt={photogenic.imageAlt || ""} loading="lazy" decoding="async" responsiveSrcset sizes="(max-width: 767px) 76vw, (max-width: 1050px) 44vw, 36rem" imgClass="photo--editorial" />
          </figure>
          {photogenic.secondaryImage && (
            <figure class="senior-print senior-confidence__secondary" aria-hidden="true">
              <Picture src={photogenic.secondaryImage} alt="" loading="lazy" decoding="async" optimizedMobileWidth={400} optimizedDesktopWidth={640} imgClass="photo--editorial" />
            </figure>
          )}
          {photogenic.scriptLine && <p class="senior-script senior-confidence__script" aria-hidden="true">{photogenic.scriptLine}</p>}
        </div>
      )}
    </div>
  </section>

  <section class:list={["senior-locations", `tone-${locations.tone}`]} aria-labelledby={`${locations.id}-title`}>
    <div class="senior-shell senior-locations__inner">
      <header class="senior-locations__heading">
        {locations.eyebrow && <p class="senior-eyebrow">{locations.eyebrow}</p>}
        <h2 id={`${locations.id}-title`}>{locations.heading}</h2>
        <div class="senior-prose">
          {locations.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </header>
      <div class="senior-locations__contact-sheet" aria-label={locations.imageAlt || undefined}>
        {locations.image && (
          <figure class="senior-print senior-locations__print senior-locations__print--one">
            <Picture src={locations.image} alt={locations.imageAlt || ""} loading="lazy" decoding="async" responsiveSrcset sizes="(max-width: 767px) 74vw, (max-width: 1050px) 47vw, 34rem" imgClass="photo--editorial" />
          </figure>
        )}
        {locations.secondaryImage && (
          <figure class="senior-print senior-locations__print senior-locations__print--two">
            <span class="senior-tape senior-tape--top" aria-hidden="true"></span>
            <Picture src={locations.secondaryImage} alt={locations.secondaryImageAlt || ""} loading="lazy" decoding="async" optimizedMobileWidth={640} optimizedDesktopWidth={960} imgClass="photo--editorial" />
          </figure>
        )}
        {page.hero.secondaryImage && (
          <figure class="senior-print senior-locations__print senior-locations__print--three" aria-hidden="true">
            <Picture src={page.hero.secondaryImage} alt="" loading="lazy" decoding="async" optimizedMobileWidth={400} optimizedDesktopWidth={640} imgClass="photo--editorial" />
          </figure>
        )}
      </div>
    </div>
  </section>

  <section class:list={["senior-plan", `tone-${planning.tone}`]} aria-labelledby={`${planning.id}-title`}>
    <div class="senior-shell senior-plan__inner">
      <header
        class:list={[
          "senior-plan__heading",
          { "senior-plan__heading--without-intro": !planning.intro },
        ]}
      >
        <div class="senior-plan__title">
          {planning.eyebrow && <p class="senior-eyebrow">{planning.eyebrow}</p>}
          <h2 id={`${planning.id}-title`}>{planning.heading}</h2>
        </div>
        {planning.image && (
          <figure class="senior-plan__portrait">
            <Picture src={planning.image} alt={planning.imageAlt || ""} loading="lazy" decoding="async" responsiveSrcset sizes="(max-width: 767px) 58vw, (max-width: 1050px) 23vw, 17rem" imgClass="photo--editorial" />
          </figure>
        )}
        {planning.intro && <p class="senior-plan__intro">{planning.intro}</p>}
      </header>
      {planning.items?.length && (
        <ol class="senior-plan__ledger">
          {planning.items.map((item, index) => (
            <li>
              <span class="senior-plan__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              {item.heading && <h3>{item.heading}</h3>}
              {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <section class:list={["senior-parents", `tone-${parents.tone}`]} aria-labelledby={`${parents.id}-title`}>
    <div class="senior-parents__background" aria-hidden="true">
      {parents.image && <Picture src={parents.image} alt="" loading="lazy" decoding="async" responsiveSrcset sizes="100vw" imgClass="senior-parents__background-image" />}
      <div class="senior-parents__wash"></div>
    </div>
    <div class="senior-parents__rule" aria-hidden="true"></div>
    <div class="senior-shell senior-parents__inner">
      <div class="senior-parents__copy">
        {parents.eyebrow && <p class="senior-eyebrow">{parents.eyebrow}</p>}
        <h2 id={`${parents.id}-title`}>{parents.heading}</h2>
        <div class="senior-prose">
          {parents.paragraphs?.map((paragraph) => {
            const linked = linkedParagraph(paragraph, aboutPhrase, parentAboutLink);
            return <p>{linked ? <>{linked.before}<a href={linked.href}>{linked.linked}</a>{linked.after}</> : paragraph}</p>;
          })}
        </div>
      </div>
      <div class="senior-parents__prints">
        <figure class="senior-print senior-parents__print senior-parents__print--rear" aria-hidden="true">
          <Picture src={parentRearImage} alt="" loading="lazy" decoding="async" optimizedMobileWidth={640} optimizedDesktopWidth={960} imgClass="photo--editorial" />
        </figure>
        {parents.secondaryImage && (
          <figure class="senior-print senior-parents__print senior-parents__print--front">
            <span class="senior-tape senior-tape--corner" aria-hidden="true"></span>
            <Picture src={parents.secondaryImage} alt={parents.secondaryImageAlt || ""} loading="lazy" decoding="async" responsiveSrcset sizes="(max-width: 767px) 57vw, (max-width: 1050px) 32vw, 22rem" imgClass="photo--editorial" />
          </figure>
        )}
      </div>
    </div>
  </section>

  <section class:list={["senior-booking", `tone-${booking.tone}`]} aria-labelledby={`${booking.id}-title`}>
    <div class="senior-shell senior-booking__inner">
      <div class="senior-booking__media">
        {booking.image && (
          <figure class="senior-booking__image">
            <Picture src={booking.image} alt={booking.imageAlt || ""} loading="lazy" decoding="async" responsiveSrcset sizes="(max-width: 767px) 82vw, (max-width: 1050px) 40vw, 31rem" imgClass="photo--editorial" />
          </figure>
        )}
        {booking.secondaryImage && (
          <figure class="senior-print senior-booking__print" aria-hidden="true">
            <Picture src={booking.secondaryImage} alt="" loading="lazy" decoding="async" optimizedMobileWidth={400} optimizedDesktopWidth={640} imgClass="photo--editorial" />
          </figure>
        )}
      </div>
      <div class="senior-booking__copy">
        {booking.eyebrow && <p class="senior-eyebrow">{booking.eyebrow}</p>}
        <h2 id={`${booking.id}-title`}>{booking.heading}</h2>
        <div class="senior-prose">
          {booking.paragraphs?.map((paragraph) => {
            const linked = linkedParagraph(paragraph, latePhrase, bookingArticleLink);
            return <p>{linked ? <>{linked.before}<a href={linked.href}>{linked.linked}</a>{linked.after}</> : paragraph}</p>;
          })}
        </div>
      </div>
    </div>
  </section>

  <section class:list={["senior-faq", `tone-${questions.tone}`]} aria-labelledby={`${questions.id}-title`}>
    <div class="senior-shell senior-faq__inner">
      <header class="senior-faq__heading">
        {questions.eyebrow && <p class="senior-eyebrow">{questions.eyebrow}</p>}
        <h2 id={`${questions.id}-title`}>{questions.heading}</h2>
      </header>
      {visibleQuestions.length > 0 && (
        <div class="senior-faq__list">
          {/* CONTENT PENDING [How many outfits can I bring?]: [PENDIENTE: número por paquete]. The verified surrounding answer remains visible; no quantity is invented. */}
          {visibleQuestions.map((item, index) => (
            <details class="senior-faq__item" open={index === 0}>
              <summary>
                <span class="senior-faq__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {item.heading && <h3>{item.heading}</h3>}
                <span class="senior-faq__mark" aria-hidden="true"></span>
              </summary>
              <div class="senior-faq__answer">
                {item.paragraphs?.map((paragraph) => {
                  const phrase = investmentPhrases.find((candidate) => paragraph.includes(candidate));
                  const linked = phrase ? linkedParagraph(paragraph, phrase, investmentLink) : undefined;
                  return <p>{linked ? <>{linked.before}<a href={linked.href}>{linked.linked}</a>{linked.after}</> : paragraph}</p>;
                })}
              </div>
            </details>
          ))}
        </div>
      )}
    </div>
  </section>

  {page.finalCta && (
    <section id="senior-final-cta" class:list={["senior-final", `tone-${page.finalCta.tone}`]} aria-labelledby="senior-final-title">
      <div class="senior-final__background" aria-hidden="true">
        <Picture src={page.finalCta.image || finalBackgroundImage} alt="" loading="lazy" decoding="async" responsiveSrcset sizes="100vw" imgClass="senior-final__background-image" />
        <div class="senior-final__wash"></div>
      </div>
      <div class="senior-shell senior-final__inner">
        {page.finalCta.eyebrow && <p class="senior-script" aria-hidden="true">{page.finalCta.eyebrow}</p>}
        <h2 id="senior-final-title">{page.finalCta.heading}</h2>
        {page.finalCta.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        {page.finalCta.link && <a class="outline-button" href={page.finalCta.link.href}>{page.finalCta.link.label}</a>}
      </div>
    </section>
  )}

  {faqSchema.length > 0 && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqSchema })} />
  )}
</article>
