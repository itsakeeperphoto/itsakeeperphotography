---
import type { EditorialPageData, PageSection } from "../../content/page-types";
import { tinaField } from "@tinacms/astro/tina-field";
import Picture from "../Picture.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/family-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

const { page } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) throw new Error(`Family page is missing the required section: ${id}`);
  return section;
};

const play = requireSection("play-not-posing");
const kids = requireSection("about-your-kids");
const preparation = requireSection("family-session-preparation");
const howItWorks = requireSection("how-it-works");
const seasonality = requireSection("family-seasonality");
const heirlooms = requireSection("family-heirlooms");
const questions = requireSection("family-session-questions");

const investmentPhrase = "we sit down in person";
const investmentHref = howItWorks.links?.[0]?.href || "/investment/";

const faqSchema = (questions.items || [])
  .filter((item) => item.heading && item.paragraphs?.length)
  .map((item) => ({
    "@type": "Question",
    name: item.heading,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.paragraphs?.join(" "),
    },
  }));
---

<article
  class="family-page"
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
  data-tina-field={tinaField(page)}
>
  <EditorialHero
    pageKey="family"
    titleId="family-hero-title"
    heading={page.hero.heading}
    headingLines={[page.hero.heading]}
    scriptLine={page.hero.scriptLine || "this season"}
    intro={page.hero.intro}
    links={page.hero.links}
    backgroundImage={page.hero.image}
    backgroundAlt={page.hero.imageAlt}
    backgroundPosition="52% 49%"
    mobileBackgroundPosition="60% 50%"
    leftPrint={{
      src: page.hero.secondaryImage,
      objectPosition: "50% 43%",
    }}
    rightPrint={{
      src: seasonality.secondaryImage,
      objectPosition: "50% 43%",
    }}
    paperEdgeColor="var(--color-warm-ivory)"
    dataTinaField={tinaField(page, "hero")}
  />

  <section
    class="family-play"
    aria-labelledby={`${play.id}-title`}
    data-tina-field={tinaField(play)}
  >
    <div class="family-shell family-play__inner">
      {play.image && (
        <figure
          class="family-play__arch"
          data-family-arch
          data-family-photo
          data-line-target="play-arch"
        >
          <Picture
            src={play.image}
            alt={play.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) min(82vw, 25rem), (max-width: 1050px) 40vw, 30vw"
            imgClass="photo--editorial"
            dataTinaField={tinaField(play, "image")}
          />
        </figure>
      )}

      <span
        class="family-play__line"
        data-construction-line
        data-line-anchor="image"
        data-anchor-target="play-arch"
        aria-hidden="true"
      ></span>

      <div class="family-play__copy">
        <span class="family-section-number" aria-hidden="true">02</span>
        <h2 id={`${play.id}-title`} data-tina-field={tinaField(play, "heading")}>{play.heading}</h2>
        <div class="family-prose" data-tina-field={tinaField(play, "paragraphs")}>
          {play.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section
    class="family-kids"
    aria-labelledby={`${kids.id}-title`}
    data-tina-field={tinaField(kids)}
  >
    <div class="family-shell">
      <header class="family-kids__header">
        <span class="family-section-number" aria-hidden="true">03</span>
        <h2 id={`${kids.id}-title`} data-tina-field={tinaField(kids, "heading")}>{kids.heading}</h2>
        {kids.intro && <p class="family-section-intro" data-tina-field={tinaField(kids, "intro")}>{kids.intro}</p>}
      </header>

      <div class="family-kids__composition">
        {(kids.image || kids.secondaryImage) && (
          <div class="family-kids__media" data-family-overlap>
            {kids.image && (
              <figure
                class="family-kids__photo family-kids__photo--arch"
                data-family-arch
                data-family-photo
              >
                <Picture
                  src={kids.image}
                  alt={kids.imageAlt || ""}
                  loading="lazy"
                  decoding="async"
                  responsiveSrcset
                  sizes="(max-width: 767px) 80vw, (max-width: 1050px) 48vw, 31vw"
                  imgClass="photo--editorial"
                  dataTinaField={tinaField(kids, "image")}
                />
              </figure>
            )}

            {kids.secondaryImage && (
              <figure
                class="family-print family-kids__photo family-kids__photo--print"
                data-family-photo
              >
                <span class="family-tape family-tape--reverse" aria-hidden="true"></span>
                <Picture
                  src={kids.secondaryImage}
                  alt={kids.secondaryImageAlt || ""}
                  loading="lazy"
                  decoding="async"
                  optimizedMobileWidth={640}
                  optimizedDesktopWidth={960}
                  imgClass="photo--editorial"
                  dataTinaField={tinaField(kids, "secondaryImage")}
                />
              </figure>
            )}
          </div>
        )}

        <div class="family-kids__ledger">
          {kids.items?.length && (
            <ul>
              {kids.items.map((item, index) => (
                <li data-tina-field={tinaField(kids, "items", index)}>
                  <span class="family-kids__node" aria-hidden="true"></span>
                  <div>
                    {item.heading && <h3>{item.heading}</h3>}
                    {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                  </div>
                </li>
              ))}
            </ul>
          )}

          {kids.paragraphs?.length && (
            <aside class="family-kids__parent-note" aria-label="A note for parents" data-tina-field={tinaField(kids, "paragraphs")}>
              {kids.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </aside>
          )}
        </div>
      </div>
    </div>
  </section>

  <section
    class="family-preparation"
    aria-labelledby={`${preparation.id}-title`}
    data-tina-field={tinaField(preparation)}
  >
    <div class="family-shell">
      <header class="family-preparation__header">
        <div>
          <span class="family-section-number" aria-hidden="true">04</span>
          <h2 id={`${preparation.id}-title`} data-tina-field={tinaField(preparation, "heading")}>{preparation.heading}</h2>
        </div>
        {preparation.intro && (
          <p class="family-section-intro" data-tina-field={tinaField(preparation, "intro")}>{preparation.intro}</p>
        )}
      </header>

      <div class="family-preparation__body">
        {preparation.items?.length && (
          <ul class="family-preparation__ledger">
            {preparation.items.map((item, index) => (
              <li data-tina-field={tinaField(preparation, "items", index)}>
                <span class="family-preparation__mark" aria-hidden="true"></span>
                <div>
                  {item.heading && <h3>{item.heading}</h3>}
                  {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </li>
            ))}
          </ul>
        )}

        {(preparation.image || preparation.secondaryImage) && (
          <div class="family-preparation__media" data-family-overlap>
            {preparation.image && (
              <figure
                class="family-preparation__photo family-preparation__photo--rear"
                data-family-photo
              >
                <Picture
                  src={preparation.image}
                  alt={preparation.imageAlt || ""}
                  loading="lazy"
                  decoding="async"
                  responsiveSrcset
                  sizes="(max-width: 767px) 88vw, (max-width: 1050px) 52vw, 35vw"
                  imgClass="photo--editorial"
                  dataTinaField={tinaField(preparation, "image")}
                />
              </figure>
            )}

            {preparation.secondaryImage && (
              <figure
                class="family-print family-preparation__photo family-preparation__photo--front"
                data-family-photo
              >
                <span class="family-tape" aria-hidden="true"></span>
                <Picture
                  src={preparation.secondaryImage}
                  alt={preparation.secondaryImageAlt || ""}
                  loading="lazy"
                  decoding="async"
                  optimizedMobileWidth={640}
                  optimizedDesktopWidth={960}
                  imgClass="photo--editorial"
                  dataTinaField={tinaField(preparation, "secondaryImage")}
                />
              </figure>
            )}
          </div>
        )}
      </div>
    </div>
  </section>

  <section
    class="family-how"
    aria-labelledby={`${howItWorks.id}-title`}
    data-tina-field={tinaField(howItWorks)}
  >
    <div class="family-shell">
      <div class="family-how__lead">
        <div class="family-how__index" aria-hidden="true">
          {howItWorks.items?.map((item, index) => (
            <span>
              <b>{String(index + 1).padStart(2, "0")}</b>
              {item.heading}
            </span>
          ))}
        </div>

        <div class="family-how__title">
          <span class="family-section-number" aria-hidden="true">05</span>
          <h2 id={`${howItWorks.id}-title`} data-tina-field={tinaField(howItWorks, "heading")}>{howItWorks.heading}</h2>
          {howItWorks.intro && (
            <p class="family-section-intro" data-tina-field={tinaField(howItWorks, "intro")}>{howItWorks.intro}</p>
          )}
        </div>
      </div>

      {(howItWorks.image || howItWorks.secondaryImage) && (
        <div class="family-how__media" data-family-overlap>
          {howItWorks.image && (
            <figure
              class="family-how__photo family-how__photo--rear"
              data-family-photo
            >
              <Picture
                src={howItWorks.image}
                alt={howItWorks.imageAlt || ""}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) 88vw, (max-width: 1050px) 67vw, 53vw"
                imgClass="photo--editorial"
                dataTinaField={tinaField(howItWorks, "image")}
              />
            </figure>
          )}

          {howItWorks.secondaryImage && (
            <figure
              class="family-print family-how__photo family-how__photo--front"
              data-family-photo
            >
              <span class="family-tape family-tape--reverse" aria-hidden="true"></span>
              <Picture
                src={howItWorks.secondaryImage}
                alt={howItWorks.secondaryImageAlt || ""}
                loading="lazy"
                decoding="async"
                optimizedMobileWidth={640}
                optimizedDesktopWidth={960}
                imgClass="photo--editorial"
                dataTinaField={tinaField(howItWorks, "secondaryImage")}
              />
            </figure>
          )}
        </div>
      )}

      {howItWorks.items?.length && (
        <ol class="family-how__ledger">
          {howItWorks.items.map((item, index) => (
            <li data-tina-field={tinaField(howItWorks, "items", index)}>
              <span class="family-how__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                {item.heading && <h3>{item.heading}</h3>}
                {item.paragraphs?.map((paragraph) => {
                  const investmentPhraseStart = paragraph.indexOf(investmentPhrase);
                  const shouldLinkInvestment =
                    index === 3 && investmentPhraseStart >= 0;
                  const beforeLink = shouldLinkInvestment
                    ? paragraph.slice(0, investmentPhraseStart)
                    : paragraph;
                  const afterLink = shouldLinkInvestment
                    ? paragraph.slice(investmentPhraseStart + investmentPhrase.length)
                    : "";

                  return (
                    <p>
                      {shouldLinkInvestment ? (
                        <>
                          {beforeLink}<a href={investmentHref}>{investmentPhrase}</a>{afterLink}
                        </>
                      ) : paragraph}
                    </p>
                  );
                })}
              </div>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <section
    class="family-seasonality"
    aria-labelledby={`${seasonality.id}-title`}
    data-tina-field={tinaField(seasonality)}
  >
    <div class="family-shell family-seasonality__inner">
      <div class="family-seasonality__copy">
        <span class="family-section-number" aria-hidden="true">06</span>
        <h2 id={`${seasonality.id}-title`} data-tina-field={tinaField(seasonality, "heading")}>{seasonality.heading}</h2>

        {seasonality.paragraphs?.length && (
          <div class="family-seasonality__seasons" data-tina-field={tinaField(seasonality, "paragraphs")}>
            {seasonality.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        )}

        {seasonality.links?.[0] && (
          <a class="family-text-link" href={seasonality.links[0].href}>
            {seasonality.links[0].label}
          </a>
        )}
      </div>

      <div class="family-seasonality__media" data-line-target="seasonality-media">
        <span
          class="family-seasonality__line"
          data-construction-line
          data-line-anchor="image"
          data-anchor-target="seasonality-media"
          aria-hidden="true"
        ></span>

        {seasonality.image && (
          <figure
            class="family-seasonality__landscape"
            data-family-photo
          >
            <span class="family-tape" aria-hidden="true"></span>
            <Picture
              src={seasonality.image}
              alt={seasonality.imageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 100vw, (max-width: 1050px) 68vw, 52vw"
              imgClass="photo--editorial"
              dataTinaField={tinaField(seasonality, "image")}
            />
          </figure>
        )}

        {seasonality.secondaryImage && (
          <figure
            class="family-seasonality__arch"
            data-family-arch
            data-family-photo
          >
            <Picture
              src={seasonality.secondaryImage}
              alt={seasonality.secondaryImageAlt || ""}
              loading="lazy"
              decoding="async"
              optimizedMobileWidth={640}
              optimizedDesktopWidth={960}
              imgClass="photo--editorial"
              dataTinaField={tinaField(seasonality, "secondaryImage")}
            />
          </figure>
        )}
      </div>
    </div>
  </section>

  <section
    class="family-heirlooms"
    aria-labelledby={`${heirlooms.id}-title`}
    data-tina-field={tinaField(heirlooms)}
  >
    {heirlooms.image && (
      <div class="family-heirlooms__background">
        <Picture
          src={heirlooms.image}
          alt={heirlooms.imageAlt || ""}
          loading="lazy"
          decoding="async"
          responsiveSrcset
          sizes="100vw"
          imgClass="family-heirlooms__background-image"
          dataTinaField={tinaField(heirlooms, "image")}
        />
        <div class="family-heirlooms__wash" aria-hidden="true"></div>
      </div>
    )}

    <div class="family-shell family-heirlooms__inner">
      <div class="family-heirlooms__copy">
        <span class="family-section-number" aria-hidden="true">07</span>
        <h2 id={`${heirlooms.id}-title`} data-tina-field={tinaField(heirlooms, "heading")}>{heirlooms.heading}</h2>
        <div class="family-prose" data-tina-field={tinaField(heirlooms, "paragraphs")}>
          {heirlooms.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        {heirlooms.links?.[0] && (
          <p class="family-context-link">
            <a href={heirlooms.links[0].href}>{heirlooms.links[0].label}</a>
          </p>
        )}
      </div>

      {heirlooms.secondaryImage && (
        <div class="family-heirlooms__media" data-family-overlap>
          <span
            class="family-heirlooms__line"
            data-construction-line
            aria-hidden="true"
          ></span>
          <figure
            class="family-print family-heirlooms__print"
            data-family-photo
          >
            <span class="family-tape" aria-hidden="true"></span>
            <Picture
              src={heirlooms.secondaryImage}
              alt={heirlooms.secondaryImageAlt || ""}
              loading="lazy"
              decoding="async"
              optimizedMobileWidth={640}
              optimizedDesktopWidth={960}
              imgClass="photo--editorial"
              dataTinaField={tinaField(heirlooms, "secondaryImage")}
            />
          </figure>
        </div>
      )}
    </div>
  </section>

  <section
    class="family-faq"
    aria-labelledby={`${questions.id}-title`}
    data-tina-field={tinaField(questions)}
  >
    <div class="family-shell family-faq__inner">
      <div class="family-faq__content">
        <header class="family-faq__heading">
          <span class="family-faq__title-rule" aria-hidden="true"></span>
          <span class="family-section-number" aria-hidden="true">08</span>
          <h2 id={`${questions.id}-title`} data-tina-field={tinaField(questions, "heading")}>{questions.heading}</h2>
        </header>

        {questions.items?.length && (
          <div class="family-faq__list">
            {questions.items.map((item, index) => (
              <details class="family-faq__item" open={index === 0} data-tina-field={tinaField(questions, "items", index)}>
                <summary>
                  <span class="family-faq__number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="family-faq__question" role="heading" aria-level="3">
                    {item.heading}
                  </span>
                  <span class="family-faq__mark" aria-hidden="true"></span>
                </summary>
                <div class="family-faq__answer">
                  {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </details>
            ))}
          </div>
        )}
      </div>

      {page.finalCta && (
        <aside
          id="family-final-cta"
          class="family-faq__note"
          aria-labelledby="family-faq-note-title"
          data-tina-field={tinaField(page, "finalCta")}
        >
          <div class="family-faq__note-paper" aria-hidden="true">
            <Picture
              src="/uploads/newborn-torn-paper-note.webp"
              alt=""
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 479px) calc(100vw - 2.5rem), (max-width: 767px) min(calc(100vw - 3rem), 26.5rem), (max-width: 1050px) 25rem, (max-width: 1250px) 23rem, 28rem"
              imgClass="family-faq__note-paper-image"
            />
          </div>
          <div class="family-faq__note-content">
            <h2 id="family-faq-note-title" data-tina-field={tinaField(page.finalCta, "heading")}>{page.finalCta.heading}</h2>
            {page.finalCta.paragraphs?.map((paragraph) => (
              <p data-tina-field={tinaField(page.finalCta, "paragraphs")}>{paragraph}</p>
            ))}
            {page.finalCta.link && (
              <a class="outline-button" href={page.finalCta.link.href}>
                {page.finalCta.link.label}
              </a>
            )}
          </div>
        </aside>
      )}
    </div>
  </section>

  {faqSchema.length > 0 && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqSchema,
      })}
    />
  )}
</article>
