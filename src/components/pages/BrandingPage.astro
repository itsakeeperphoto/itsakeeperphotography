---
import type {
  EditorialPageData,
  PageLink,
  PageSection,
} from "../../content/page-types";
import { tinaField } from "@tinacms/astro/tina-field";
import Picture from "../Picture.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/branding-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

interface LinkedParagraph {
  text: string;
  before?: string;
  after?: string;
  link?: PageLink;
}

const { page } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) {
    throw new Error(`Branding page is missing the required section: ${id}`);
  }
  return section;
};

const linkParagraphs = (
  paragraphs: Array<string | null> | null = [],
  links: Array<PageLink | null> | null = [],
): LinkedParagraph[] =>
  (paragraphs ?? [])
    .filter((paragraph): paragraph is string => Boolean(paragraph))
    .map((paragraph) => {
      const link = (links ?? []).find(
        (candidate): candidate is PageLink =>
          Boolean(candidate && paragraph.includes(candidate.label)),
      );
      if (!link) return { text: paragraph };

      const start = paragraph.indexOf(link.label);
      return {
        text: paragraph,
        before: paragraph.slice(0, start),
        after: paragraph.slice(start + link.label.length),
        link,
      };
    });

const people = requireSection("people-hire-people");
const custom = requireSection("custom-business-photography");
const photograph = requireSection("what-well-photograph");
const rights = requireSection("usage-rights");
const audiences = requireSection("who-books-branding-sessions");
const process = requireSection("how-it-works");
const questions = requireSection("branding-questions");

const audienceParagraphs = linkParagraphs(
  audiences.paragraphs,
  audiences.links,
);
const faqItems = (questions.items || []).map((item) => ({
  ...item,
  linkedParagraphs: linkParagraphs(item.paragraphs, item.links),
}));

const brandingMosaicMedia = [0, 1, 2, 3].map((index) => {
  const item = photograph.items?.[index];
  if (!item?.image || !item.imageAlt) {
    throw new Error(
      "Branding page requires four complete What We'll Photograph images.",
    );
  }
  return { image: item.image, imageAlt: item.imageAlt };
});

const lisaWorkingImage = "/uploads/lisa-photographer-at-work-black-white.jpg";
const lisaPortraitImage = "/uploads/lisa-photographer-tricities.jpg";
const businessPortraitImage =
  people.image || "/uploads/business-branding-portrait-richland.jpg";
const businessHeadshotImage =
  people.secondaryImage ||
  "/uploads/review-lisa-griffith-headshot-tricities.jpg";

// CONTENT PENDING: [PENDIENTE: entregables exactos, cantidad de imágenes, duración por paquete]
---

<article
  class="branding-page"
  data-branding-page
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
  data-tina-field={tinaField(page)}
>
  <EditorialHero
    pageKey="branding"
    titleId="branding-hero-title"
    heading={page.hero.heading}
    headingLines={[
      "Branding Photography",
      "for Tri-Cities",
      "Businesses",
    ]}
    scriptLine="your work"
    intro={page.hero.intro}
    links={page.hero.links}
    backgroundImage={page.hero.image || lisaWorkingImage}
    backgroundAlt={page.hero.imageAlt || "Lisa Weiss working with her camera."}
    backgroundPosition="50% 48%"
    mobileBackgroundPosition="49% 46%"
    leftPrint={{
      src: page.hero.secondaryImage || businessPortraitImage,
      objectPosition: "50% 44%",
    }}
    rightPrint={{
      src: lisaPortraitImage,
      objectPosition: "50% 42%",
    }}
    paperEdgeColor="var(--color-warm-ivory)"
    dataTinaField={tinaField(page, "hero")}
  />

  <section
    class="branding-face"
    data-branding-section="people"
    aria-labelledby={`${people.id}-title`}
    data-tina-field={tinaField(page, "sections", page.sections.indexOf(people))}
  >
    <div class="branding-shell branding-face__inner">
      <div class="branding-face__media" data-line-target="people-media">
        <span
          class="branding-face__line"
          data-construction-line
          data-line-anchor="image"
          data-anchor-target="people-arch"
          aria-hidden="true"
        ></span>

        <figure
          class="branding-face__arch"
          data-branding-arch="people"
          data-branding-photo="portrait"
          data-line-target="people-arch"
        >
          <Picture
            src={businessPortraitImage}
            alt={people.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 76vw, (max-width: 1050px) 38vw, 27vw"
            imgClass="photo--editorial"
          />
        </figure>

        <figure
          class="branding-print branding-face__print"
          data-branding-photo="headshot"
        >
          <span class="branding-tape" aria-hidden="true"></span>
          <Picture
            src={businessHeadshotImage}
            alt={people.secondaryImageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
              sizes="(max-width: 767px) 42vw, (max-width: 1050px) 22vw, 16vw"
            imgClass="branding-face__print-image photo--editorial"
          />
        </figure>
      </div>

      <div class="branding-face__copy">
        <h2 id={`${people.id}-title`}>{people.heading}</h2>
        <div class="branding-prose">
          {people.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section
    class="branding-custom"
    data-branding-section="custom"
    aria-labelledby={`${custom.id}-title`}
    data-tina-field={tinaField(page, "sections", page.sections.indexOf(custom))}
  >
    <div class="branding-shell branding-custom__inner">
      <div class="branding-custom__copy">
        <h2 id={`${custom.id}-title`}>{custom.heading}</h2>
        <div class="branding-prose">
          {custom.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div
        class="branding-custom__mosaic"
        data-branding-mosaic
        data-line-target="branding-mosaic"
      >
        <span
          class="branding-custom__line branding-custom__line--horizontal"
          data-construction-line
          data-line-anchor="image"
          data-anchor-target="branding-mosaic"
          aria-hidden="true"
        ></span>
        <span
          class="branding-custom__line branding-custom__line--vertical"
          data-construction-line
          data-line-anchor="image"
          data-anchor-target="branding-mosaic"
          aria-hidden="true"
        ></span>

        <figure
          class="branding-print branding-custom__photo branding-custom__photo--portrait"
          data-branding-photo="portrait"
        >
          <Picture
            src={brandingMosaicMedia[0].image}
            alt={brandingMosaicMedia[0].imageAlt}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 36vw, (max-width: 1050px) 30vw, 18vw"
            imgClass="photo--editorial"
          />
        </figure>

        <figure
          class="branding-print branding-custom__photo branding-custom__photo--working"
          data-branding-photo="working"
        >
          <span class="branding-tape" aria-hidden="true"></span>
          <Picture
            src={brandingMosaicMedia[1].image}
            alt={brandingMosaicMedia[1].imageAlt}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 48vw, (max-width: 1050px) 40vw, 24vw"
            imgClass="photo--editorial"
          />
        </figure>

        <figure
          class="branding-print branding-custom__photo branding-custom__photo--detail"
          data-branding-photo="headshot"
          aria-hidden="true"
        >
          <Picture
            src={brandingMosaicMedia[3].image}
            alt=""
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 39vw, (max-width: 1050px) 31vw, 18vw"
            imgClass="photo--editorial"
          />
        </figure>

        <figure
          class="branding-print branding-custom__photo branding-custom__photo--space"
          data-branding-photo="photographer"
          aria-hidden="true"
        >
          <Picture
            src={brandingMosaicMedia[2].image}
            alt=""
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 32vw, (max-width: 1050px) 27vw, 17vw"
            imgClass="photo--editorial"
          />
        </figure>
      </div>
    </div>
  </section>

  <section
    class="branding-library"
    data-branding-section="photograph"
    aria-labelledby={`${photograph.id}-title`}
    data-tina-field={tinaField(page, "sections", page.sections.indexOf(photograph))}
  >
    <div class="branding-shell branding-library__inner">
      <header class="branding-library__heading">
        <h2 id={`${photograph.id}-title`}>{photograph.heading}</h2>
        {photograph.intro && <p>{photograph.intro}</p>}
      </header>

      {photograph.items?.length && (
        <ol class="branding-library__list" data-line-target="brand-library">
          {photograph.items.map((item, index) => (
            <li data-tina-field={tinaField(photograph, "items", index)}>
              <span class="branding-library__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              {item.heading && <h3>{item.heading}</h3>}
              {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <section
    class="branding-rights"
    data-branding-section="rights"
    aria-labelledby={`${rights.id}-title`}
    data-tina-field={tinaField(page, "sections", page.sections.indexOf(rights))}
  >
    <div class="branding-shell branding-rights__inner">
      <header class="branding-rights__heading">
        <h2 id={`${rights.id}-title`}>{rights.heading}</h2>
        {rights.intro && <p>{rights.intro}</p>}
      </header>

      {rights.items?.length && (
        <div class="branding-rights__comparison" data-line-target="usage-rights">
          {rights.items.map((item, index) => (
            <article
              class="branding-rights__item"
              data-rights-tier={index === 1 ? "commercial" : "personal"}
              data-tina-field={tinaField(rights, "items", index)}
            >
              <span class="branding-rights__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              {item.heading && <h3>{item.heading}</h3>}
              {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            </article>
          ))}
        </div>
      )}

      <div class="branding-rights__close">
        {rights.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section
    class="branding-audiences"
    data-branding-section="audiences"
    aria-labelledby={`${audiences.id}-title`}
    data-tina-field={tinaField(page, "sections", page.sections.indexOf(audiences))}
  >
    <div class="branding-shell branding-audiences__inner">
      <header class="branding-audiences__heading">
        <h2 id={`${audiences.id}-title`}>{audiences.heading}</h2>
      </header>

      <div
        class="branding-audiences__triptych"
        data-branding-triptych
        data-line-target="audience-triptych"
      >
        <figure
          class="branding-audiences__panel branding-audiences__panel--left"
          data-branding-panel="left"
        >
          <Picture
            src={audiences.image || businessPortraitImage}
            alt={audiences.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 44vw, (max-width: 1050px) 38vw, 22vw"
            imgClass="photo--editorial"
          />
        </figure>

        <figure
          class="branding-audiences__panel branding-audiences__panel--center"
          data-branding-panel="center"
          data-branding-arch="audience"
        >
          <Picture
            src={audiences.secondaryImage || businessHeadshotImage}
            alt={audiences.secondaryImageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 82vw, (max-width: 1050px) 48vw, 25vw"
            imgClass="photo--editorial"
          />
        </figure>

        <figure
          class="branding-audiences__panel branding-audiences__panel--right"
          data-branding-panel="right"
        >
          <Picture
            src={lisaPortraitImage}
            alt="Lisa Weiss holding her camera for a professional portrait."
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 44vw, (max-width: 1050px) 38vw, 22vw"
            imgClass="photo--editorial"
          />
        </figure>
      </div>

      <div class="branding-audiences__copy branding-prose">
        {audienceParagraphs.map((paragraph) => (
          <p>
            {paragraph.link ? (
              <>
                {paragraph.before}<a
                  class="branding-inline-link"
                  href={paragraph.link.href}
                >{paragraph.link.label}</a>{paragraph.after}
              </>
            ) : (
              paragraph.text
            )}
          </p>
        ))}
      </div>
    </div>
  </section>

  <section
    class="branding-includes"
    data-branding-section="process"
    aria-labelledby={`${process.id}-title`}
    data-tina-field={tinaField(page, "sections", page.sections.indexOf(process))}
  >
    <div class="branding-shell branding-includes__inner">
      <header class="branding-includes__heading">
        <h2 id={`${process.id}-title`}>{process.heading}</h2>
      </header>

      {process.items?.length && (
        <ol
          class="branding-includes__ledger"
          data-branding-process
          data-line-target="branding-process"
        >
          {process.items.map((item, index) => {
            const headingLink = item.links?.find(
              (link) => link.label === item.heading,
            );

            return (
              <li
                data-branding-step
                data-tina-field={tinaField(process, "items", index)}
              >
                <span class="branding-includes__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {item.heading && (
                  <h3>
                    {headingLink ? (
                      <a
                        class="branding-inline-link"
                        href={headingLink.href}
                      >{item.heading}</a>
                    ) : (
                      item.heading
                    )}
                  </h3>
                )}
                {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              </li>
            );
          })}
        </ol>
      )}
    </div>
  </section>

  <section
    class="branding-faq"
    data-branding-faq
    data-branding-section="questions"
    aria-labelledby={`${questions.id}-title`}
    data-tina-field={tinaField(page, "sections", page.sections.indexOf(questions))}
  >
    <div class="branding-shell branding-faq__inner">
      <header class="branding-faq__heading">
        <h2 id={`${questions.id}-title`}>{questions.heading}</h2>
      </header>

      {faqItems.length > 0 && (
        <div class="branding-faq__list">
          {faqItems.map((item, index) => (
            <details
              class="branding-faq__item"
              open={index === 0}
              data-tina-field={tinaField(questions, "items", index)}
            >
              <summary>
                <span class="branding-faq__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="branding-faq__question" role="heading" aria-level="3">
                  {item.heading}
                </span>
                <span class="branding-faq__mark" aria-hidden="true">+</span>
              </summary>
              <div class="branding-faq__answer">
                {item.linkedParagraphs.map((paragraph) => (
                  <p>
                    {paragraph.link ? (
                      <>
                        {paragraph.before}<a
                          class="branding-inline-link"
                          href={paragraph.link.href}
                        >{paragraph.link.label}</a>{paragraph.after}
                      </>
                    ) : (
                      paragraph.text
                    )}
                  </p>
                ))}
              </div>
            </details>
          ))}
        </div>
      )}
    </div>
  </section>

  {page.finalCta && (
    <section
      id="branding-final-cta"
      class="branding-final"
      data-branding-final
      aria-labelledby="branding-final-title"
      data-tina-field={tinaField(page, "finalCta")}
    >
      <div class="branding-final__background" aria-hidden="true">
        <Picture
          src={page.finalCta.image || lisaWorkingImage}
          alt=""
          loading="lazy"
          decoding="async"
          responsiveSrcset
          sizes="100vw"
          imgClass="branding-final__image photo--editorial"
        />
        <div class="branding-final__wash"></div>
      </div>

      <div class="branding-shell branding-final__inner">
        <div class="branding-final__frame">
          <p class="branding-script" aria-hidden="true">who you are</p>
          <h2 id="branding-final-title">{page.finalCta.heading}</h2>
          {page.finalCta.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {page.finalCta.link && (
            <a class="outline-button" href={page.finalCta.link.href}>
              {page.finalCta.link.label}
            </a>
          )}
        </div>
      </div>
    </section>
  )}
</article>
