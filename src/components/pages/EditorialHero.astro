---
import type { PageLink } from "../../content/page-types";
import Picture from "../Picture.astro";
import "../../styles/editorial-hero.css";

interface HeroPrint {
  src?: string;
  objectPosition?: string;
}

interface Props {
  pageKey:
    | "senior"
    | "family"
    | "newborn"
    | "headshots"
    | "about"
    | "branding"
    | "journal";
  titleId: string;
  heading: string;
  headingLines: string[];
  scriptLine: string;
  intro?: string;
  links?: PageLink[];
  backgroundImage?: string;
  backgroundAlt?: string;
  backgroundPosition?: string;
  mobileBackgroundPosition?: string;
  leftPrint?: HeroPrint;
  rightPrint?: HeroPrint;
  paperEdgeColor?: string;
}

const {
  pageKey,
  titleId,
  heading,
  headingLines,
  scriptLine,
  intro,
  links = [],
  backgroundImage,
  backgroundAlt = "",
  backgroundPosition = "54% 50%",
  mobileBackgroundPosition = backgroundPosition,
  leftPrint,
  rightPrint,
  paperEdgeColor = "var(--color-weathered-sand)",
} = Astro.props;

const heroStyle = [
  `--editorial-hero-background-position: ${backgroundPosition}`,
  `--editorial-hero-background-position-mobile: ${mobileBackgroundPosition}`,
  `--editorial-hero-left-print-position: ${leftPrint?.objectPosition || "50% 45%"}`,
  `--editorial-hero-right-print-position: ${rightPrint?.objectPosition || "50% 48%"}`,
  `--editorial-hero-paper-edge: ${paperEdgeColor}`,
].join("; ");
---

<header
  class="editorial-hero"
  aria-labelledby={titleId}
  data-editorial-hero
  data-editorial-hero-page={pageKey}
  style={heroStyle}
>
  <div class="editorial-hero__background" data-hero-background>
    {backgroundImage && (
      <Picture
        src={backgroundImage}
        alt={backgroundAlt}
        loading="eager"
        decoding="async"
        fetchpriority="high"
        responsiveSrcset
        sizes="100vw"
        imgClass="editorial-hero__background-image"
      />
    )}
    <div class="editorial-hero__wash" data-hero-wash aria-hidden="true"></div>
  </div>

  {leftPrint?.src && (
    <figure
      class="editorial-hero__print editorial-hero__print--left"
      data-hero-print="left"
      aria-hidden="true"
    >
      <Picture
        src={leftPrint.src}
        alt=""
        loading="eager"
        decoding="async"
        optimizedMobileWidth={400}
        optimizedDesktopWidth={640}
        imgClass="photo--editorial"
      />
    </figure>
  )}

  <div class="editorial-hero__copy" data-hero-copy>
    <p
      class="editorial-hero__script"
      data-hero-script
      aria-hidden="true"
    >
      {scriptLine}
    </p>
    <h1
      class="editorial-hero__title"
      id={titleId}
      data-hero-title
      aria-label={heading}
    >
      {headingLines.map((line) => <span aria-hidden="true">{line}</span>)}
    </h1>
    {intro && (
      <p class="editorial-hero__intro" data-hero-intro>{intro}</p>
    )}
    {links.length > 0 && (
      <div class="editorial-hero__actions">
        {links.map((link) => (
          <a class="outline-button" data-hero-cta href={link.href}>
            {link.label}
          </a>
        ))}
      </div>
    )}
  </div>

  {rightPrint?.src && (
    <figure
      class="editorial-hero__print editorial-hero__print--right"
      data-hero-print="right"
      aria-hidden="true"
    >
      <Picture
        src={rightPrint.src}
        alt=""
        loading="eager"
        decoding="async"
        optimizedMobileWidth={400}
        optimizedDesktopWidth={640}
        imgClass="photo--editorial"
      />
    </figure>
  )}

  <div class="editorial-hero__paper-edge" data-hero-paper-edge aria-hidden="true"></div>
</header>
