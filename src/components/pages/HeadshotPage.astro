---
import type {
  EditorialPageData,
  PageLink,
  PageSection,
} from "../../content/page-types";
import Picture from "../Picture.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/headshot-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

interface LinkedSegment {
  text: string;
  link?: PageLink;
}

const { page } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) throw new Error(`Headshot page is missing the required section: ${id}`);
  return section;
};

const studio = requireSection("i-bring-the-studio-to-you");
const useful = requireSection("a-headshot-you-will-actually-use");
const guided = requireSection("even-if-you-hate-pictures");
const teams = requireSection("headshots-for-teams");
const process = requireSection("headshot-session-process");
const questions = requireSection("headshot-questions");

const heroHeadingMatch = page.hero.heading.match(/^(.*?)\s+in\s+(.*)$/i);
const heroHeadingLines = heroHeadingMatch
  ? [heroHeadingMatch[1], `in ${heroHeadingMatch[2]}`]
  : [page.hero.heading];

const splitWithLinks = (
  paragraph: string,
  links: PageLink[] = [],
): LinkedSegment[] => {
  const matches = links
    .map((link) => ({
      link,
      start: paragraph.indexOf(link.label),
    }))
    .filter((match) => match.start >= 0)
    .sort((a, b) => a.start - b.start);

  if (matches.length === 0) return [{ text: paragraph }];

  const segments: LinkedSegment[] = [];
  let cursor = 0;

  for (const match of matches) {
    if (match.start < cursor) continue;
    if (match.start > cursor) {
      segments.push({ text: paragraph.slice(cursor, match.start) });
    }
    segments.push({ text: match.link.label, link: match.link });
    cursor = match.start + match.link.label.length;
  }

  if (cursor < paragraph.length) {
    segments.push({ text: paragraph.slice(cursor) });
  }

  return segments;
};

const faqSchema = (questions.items || [])
  .filter((item) => item.heading && item.paragraphs?.length)
  .map((item) => ({
    "@type": "Question",
    name: item.heading,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.paragraphs?.join(" "),
    },
  }));
---

<article
  class="headshot-page"
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
>
  <EditorialHero
    pageKey="headshots"
    titleId="headshot-hero-title"
    heading={page.hero.heading}
    headingLines={heroHeadingLines}
    scriptLine={page.hero.scriptLine || ""}
    intro={page.hero.intro}
    links={page.hero.links}
    backgroundImage={page.hero.image}
    backgroundAlt={page.hero.imageAlt}
    backgroundPosition="50% 48%"
    mobileBackgroundPosition="54% 50%"
    leftPrint={{
      src: page.hero.secondaryImage,
      objectPosition: "50% 42%",
    }}
    rightPrint={{
      src: studio.secondaryImage,
      objectPosition: "50% 34%",
    }}
    paperEdgeColor="var(--color-warm-ivory)"
  />

  <section
    id={studio.id}
    class:list={["headshot-studio", `tone-${studio.tone}`]}
    aria-labelledby={`${studio.id}-title`}
  >
    <div class="headshot-shell headshot-studio__inner">
      <div class="headshot-studio__copy">
        <span class="headshot-rule" aria-hidden="true"></span>
        <h2 id={`${studio.id}-title`}>{studio.heading}</h2>
        <div class="headshot-prose">
          {studio.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div class="headshot-studio__media">
        <span class="headshot-studio__construction" aria-hidden="true"></span>
        {studio.image && (
          <figure class="headshot-studio__primary">
            <Picture
              src={studio.image}
              alt={studio.imageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 82vw, (max-width: 1050px) 46vw, 31rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}
        {studio.secondaryImage && (
          <figure class="headshot-print headshot-studio__proof">
            <span class="headshot-tape" aria-hidden="true"></span>
            <Picture
              src={studio.secondaryImage}
              alt={studio.secondaryImageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 42vw, (max-width: 1050px) 22vw, 14rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}
      </div>
    </div>
  </section>

  <section
    id={useful.id}
    class:list={["headshot-useful", `tone-${useful.tone}`]}
    aria-labelledby={`${useful.id}-title`}
  >
    <div class="headshot-shell headshot-useful__inner">
      <div class="headshot-useful__media">
        <span class="headshot-useful__line" aria-hidden="true"></span>
        {useful.image && (
          <figure class="headshot-useful__arch">
            <Picture
              src={useful.image}
              alt={useful.imageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 78vw, (max-width: 1050px) 40vw, 25rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}
        {useful.secondaryImage && (
          <figure class="headshot-print headshot-useful__proof" aria-hidden="true">
            <Picture
              src={useful.secondaryImage}
              alt=""
              loading="lazy"
              decoding="async"
              optimizedMobileWidth={360}
              optimizedDesktopWidth={520}
              imgClass="photo--editorial"
            />
          </figure>
        )}
      </div>

      <div class="headshot-useful__copy">
        <span class="headshot-rule" aria-hidden="true"></span>
        <h2 id={`${useful.id}-title`}>{useful.heading}</h2>
        <div class="headshot-prose">
          {useful.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section
    id={guided.id}
    class:list={["headshot-guided", `tone-${guided.tone}`]}
    aria-labelledby={`${guided.id}-title`}
  >
    <div class="headshot-shell headshot-guided__inner">
      <div class="headshot-guided__copy">
        <span class="headshot-rule" aria-hidden="true"></span>
        <h2 id={`${guided.id}-title`}>{guided.heading}</h2>
        <div class="headshot-prose">
          {guided.paragraphs?.map((paragraph) => (
            <p>
              {splitWithLinks(paragraph, guided.links).map((segment) =>
                segment.link ? (
                  <a href={segment.link.href}>{segment.text}</a>
                ) : (
                  segment.text
                ),
              )}
            </p>
          ))}
        </div>
      </div>

      <div class="headshot-guided__media">
        <span class="headshot-guided__line" aria-hidden="true"></span>
        {guided.image && (
          <figure class="headshot-guided__primary">
            <Picture
              src={guided.image}
              alt={guided.imageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 76vw, (max-width: 1050px) 42vw, 28rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}
        {guided.secondaryImage && (
          <figure class="headshot-print headshot-guided__secondary">
            <span class="headshot-tape" aria-hidden="true"></span>
            <Picture
              src={guided.secondaryImage}
              alt={guided.secondaryImageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 42vw, (max-width: 1050px) 24vw, 16rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}
      </div>
    </div>
  </section>

  <section
    id={teams.id}
    class:list={["headshot-teams", `tone-${teams.tone}`]}
    aria-labelledby={`${teams.id}-title`}
  >
    <div class="headshot-shell headshot-teams__inner">
      <header class="headshot-teams__heading">
        <span class="headshot-rule" aria-hidden="true"></span>
        <h2 id={`${teams.id}-title`}>{teams.heading}</h2>
      </header>

      <div class="headshot-teams__copy headshot-prose">
        {teams.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="headshot-teams__proofs">
        <span class="headshot-teams__line" aria-hidden="true"></span>
        {teams.image && (
          <figure class="headshot-print headshot-teams__proof headshot-teams__proof--first">
            <Picture
              src={teams.image}
              alt={teams.imageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 55vw, (max-width: 1050px) 28vw, 19rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}
        {teams.secondaryImage && (
          <figure class="headshot-print headshot-teams__proof headshot-teams__proof--second">
            <Picture
              src={teams.secondaryImage}
              alt={teams.secondaryImageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 52vw, (max-width: 1050px) 26vw, 18rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}
      </div>
    </div>
  </section>

  <section
    id={process.id}
    class:list={["headshot-process", `tone-${process.tone}`]}
    aria-labelledby={`${process.id}-title`}
  >
    <div class="headshot-shell headshot-process__inner">
      <header class="headshot-process__heading">
        <span class="headshot-rule" aria-hidden="true"></span>
        <h2 id={`${process.id}-title`}>{process.heading}</h2>
      </header>

      {process.image && (
        <figure class="headshot-process__photo">
          <Picture
            src={process.image}
            alt={process.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 88vw, (max-width: 1050px) 42vw, 28rem"
            imgClass="photo--editorial"
          />
        </figure>
      )}

      {process.items?.length && (
        <ol class="headshot-process__steps">
          {process.items.map((item, index) => (
            <li>
              <span class="headshot-process__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                {item.heading && <h3>{item.heading}</h3>}
                {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </li>
          ))}
        </ol>
      )}

      {/* CONTENT PENDING: [PENDIENTE: duración y entregables exactos por paquete] */}
    </div>
  </section>

  <section
    id={questions.id}
    class:list={["headshot-faq", `tone-${questions.tone}`]}
    aria-labelledby={`${questions.id}-title`}
  >
    <div class="headshot-shell headshot-faq__inner">
      <header class="headshot-faq__heading">
        <span class="headshot-rule" aria-hidden="true"></span>
        <h2 id={`${questions.id}-title`}>{questions.heading}</h2>
        {questions.image && (
          <figure class="headshot-faq__arch">
            <Picture
              src={questions.image}
              alt={questions.imageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 60vw, (max-width: 1050px) 28vw, 18rem"
              imgClass="photo--editorial"
            />
          </figure>
        )}
      </header>

      {questions.items?.length && (
        <div class="headshot-faq__list">
          {questions.items.map((item, index) => (
            <details class="headshot-faq__item" open={index === 0}>
              <summary>
                <span class="headshot-faq__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {item.heading && <h3>{item.heading}</h3>}
                <span class="headshot-faq__mark" aria-hidden="true"></span>
              </summary>
              <div class="headshot-faq__answer">
                {item.paragraphs?.map((paragraph) => (
                  <p>
                    {splitWithLinks(paragraph, item.links).map((segment) =>
                      segment.link ? (
                        <a href={segment.link.href}>{segment.text}</a>
                      ) : (
                        segment.text
                      ),
                    )}
                  </p>
                ))}
              </div>
            </details>
          ))}
        </div>
      )}
    </div>
  </section>

  {page.finalCta && (
    <section
      id="headshot-final-cta"
      class:list={["headshot-final", `tone-${page.finalCta.tone}`]}
      aria-labelledby="headshot-final-title"
    >
      {page.finalCta.image && (
        <div class="headshot-final__background" aria-hidden="true">
          <Picture
            src={page.finalCta.image}
            alt=""
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="100vw"
            imgClass="headshot-final__background-image"
          />
          <div class="headshot-final__wash" aria-hidden="true"></div>
        </div>
      )}

      <div class="headshot-shell headshot-final__inner">
        <div class="headshot-final__copy">
          <h2 id="headshot-final-title">{page.finalCta.heading}</h2>
          {page.finalCta.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {page.finalCta.link && (
            <a
              class="outline-button"
              href={page.finalCta.link.href}
              target={page.finalCta.link.external ? "_blank" : undefined}
              rel={page.finalCta.link.external ? "noopener noreferrer" : undefined}
            >
              {page.finalCta.link.label}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {faqSchema.length > 0 && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqSchema,
      })}
    />
  )}
</article>
