---
import type { EditorialPageData, PageSection } from "../../content/page-types";
import Picture from "../Picture.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/headshot-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

const { page } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) throw new Error(`Headshot page is missing the required section: ${id}`);
  return section;
};

const proud = requireSection("a-headshot-you-are-proud-to-use");
const guided = requireSection("even-if-you-hate-pictures");
const process = requireSection("headshot-session-process");
const teams = requireSection("headshots-for-teams");
const questions = requireSection("headshot-questions");

const heroHeadingMatch = page.hero.heading.match(/^(.*?)\s+in\s+(.*)$/i);
const heroHeadingLines = heroHeadingMatch
  ? [heroHeadingMatch[1], `in ${heroHeadingMatch[2]}`]
  : [page.hero.heading];

const teamItems = teams.items || [];
const finalLeftPrint = teamItems[0]?.image || page.hero.secondaryImage;
const finalRightPrint = teamItems[2]?.image || guided.secondaryImage;

const faqSchema = (questions.items || [])
  .filter((item) => item.heading && item.paragraphs?.length)
  .map((item) => ({
    "@type": "Question",
    name: item.heading,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.paragraphs?.join(" "),
    },
  }));
---

<article
  class="headshot-page"
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
>
  <EditorialHero
    pageKey="headshots"
    titleId="headshot-hero-title"
    heading={page.hero.heading}
    headingLines={heroHeadingLines}
    scriptLine={page.hero.scriptLine || ""}
    intro={page.hero.intro}
    links={page.hero.links}
    backgroundImage={page.hero.image}
    backgroundAlt={page.hero.imageAlt}
    backgroundPosition="50% 48%"
    mobileBackgroundPosition="54% 50%"
    leftPrint={{
      src: page.hero.secondaryImage,
      objectPosition: "50% 42%",
    }}
    rightPrint={{
      src: guided.secondaryImage,
      objectPosition: "50% 44%",
    }}
    paperEdgeColor="var(--color-warm-ivory)"
  />

  <section
    id={proud.id}
    class:list={["headshot-proud", `tone-${proud.tone}`]}
    aria-labelledby={`${proud.id}-title`}
  >
    <div class="headshot-shell headshot-proud__inner">
      {proud.image && (
        <figure class="headshot-proud__arch">
          <Picture
            src={proud.image}
            alt={proud.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 82vw, (max-width: 1050px) 40vw, 25rem"
            imgClass="photo--editorial"
          />
        </figure>
      )}

      <div class="headshot-proud__copy">
        <span class="headshot-rule" aria-hidden="true"></span>
        <h2 id={`${proud.id}-title`}>{proud.heading}</h2>
        <div class="headshot-prose">
          {proud.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {proud.links?.length && (
          <div class="headshot-links">
            {proud.links.map((link) => (
              <a
                class="headshot-text-link"
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <section
    id={guided.id}
    class:list={["headshot-guided", `tone-${guided.tone}`]}
    aria-labelledby={`${guided.id}-title`}
  >
    <div class="headshot-shell headshot-guided__inner">
      <div class="headshot-guided__copy">
        <span class="headshot-rule" aria-hidden="true"></span>
        <h2 id={`${guided.id}-title`}>{guided.heading}</h2>
        <div class="headshot-prose">
          {guided.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {guided.links?.length && (
          <div class="headshot-links">
            {guided.links.map((link) => (
              <a
                class="headshot-text-link"
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>

      {(guided.image || guided.secondaryImage || guided.scriptLine) && (
        <div class="headshot-guided__media">
          {guided.image && (
            <figure class="headshot-print headshot-guided__primary">
              <Picture
                src={guided.image}
                alt={guided.imageAlt || ""}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) 84vw, (max-width: 1050px) 48vw, 31rem"
                imgClass="photo--editorial"
              />
            </figure>
          )}

          {guided.secondaryImage && (
            <figure
              class="headshot-print headshot-guided__secondary"
              aria-hidden="true"
            >
              <Picture
                src={guided.secondaryImage}
                alt=""
                loading="lazy"
                decoding="async"
                optimizedMobileWidth={400}
                optimizedDesktopWidth={640}
                imgClass="photo--editorial"
              />
            </figure>
          )}

          {guided.scriptLine && (
            <div class="headshot-guided__note" aria-hidden="true">
              <span class="headshot-guided__pin"></span>
              <p>{guided.scriptLine}</p>
            </div>
          )}

          <span class="headshot-guided__clay-accent" aria-hidden="true"></span>
        </div>
      )}
    </div>
  </section>

  <section
    id={process.id}
    class:list={["headshot-process", `tone-${process.tone}`]}
    aria-labelledby={`${process.id}-title`}
  >
    <div class="headshot-shell headshot-process__inner">
      <header class="headshot-process__heading">
        <span class="headshot-rule" aria-hidden="true"></span>
        <h2 id={`${process.id}-title`}>{process.heading}</h2>
        {process.intro && <p>{process.intro}</p>}
      </header>

      {process.image && (
        <figure class="headshot-print headshot-process__photo">
          <span class="headshot-tape" aria-hidden="true"></span>
          <Picture
            src={process.image}
            alt={process.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 88vw, (max-width: 1050px) 48vw, 34rem"
            imgClass="photo--editorial"
          />
        </figure>
      )}

      {process.items?.length && (
        <ol class="headshot-process__steps">
          {process.items.map((item, index) => (
            <li>
              <span class="headshot-process__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                {item.heading && <h3>{item.heading}</h3>}
                {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </li>
          ))}
        </ol>
      )}

      {process.links?.length && (
        <div class="headshot-links headshot-process__links">
          {process.links.map((link) => (
            <a
              class="headshot-text-link"
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section
    id={teams.id}
    class:list={["headshot-teams", `tone-${teams.tone}`]}
    aria-labelledby={`${teams.id}-title`}
  >
    <div class="headshot-shell headshot-teams__inner">
      <h2 class="sr-only" id={`${teams.id}-title`}>{teams.heading}</h2>

      {teamItems.length > 0 && (
        <div class="headshot-teams__gallery">
          <svg
            class="headshot-teams__arc-copy"
            viewBox="0 0 520 220"
            role="presentation"
            aria-hidden="true"
          >
            <defs>
              <path
                id="headshot-teams-arc"
                d="M 38 188 A 224 224 0 0 1 482 188"
              ></path>
            </defs>
            <text>
              <textPath
                href="#headshot-teams-arc"
                startOffset="50%"
                text-anchor="middle"
              >
                {teams.heading?.toUpperCase()}
              </textPath>
            </text>
          </svg>

          <ul class="headshot-teams__triptych">
            {teamItems.map((item, index) => (
              <li
                class:list={[
                  "headshot-teams__item",
                  { "headshot-teams__item--arch": index === 1 },
                ]}
              >
                {item.image && (
                  <figure>
                    <Picture
                      src={item.image}
                      alt={item.imageAlt || ""}
                      loading="lazy"
                      decoding="async"
                      responsiveSrcset
                      sizes="(max-width: 767px) 82vw, (max-width: 1050px) 30vw, 23rem"
                      imgClass="photo--editorial"
                    />
                  </figure>
                )}
              </li>
            ))}
          </ul>

          <span class="headshot-teams__clay-accent" aria-hidden="true"></span>
        </div>
      )}

      <div class="headshot-teams__copy">
        <div class="headshot-prose">
          {teams.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {teams.links?.length && (
          <div class="headshot-links">
            {teams.links.map((link) => (
              <a
                class="headshot-text-link"
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <section
    id={questions.id}
    class:list={["headshot-faq", `tone-${questions.tone}`]}
    aria-labelledby={`${questions.id}-title`}
  >
    <div class="headshot-shell headshot-faq__inner">
      {questions.image && (
        <figure class="headshot-faq__photo">
          <Picture
            src={questions.image}
            alt={questions.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 88vw, (max-width: 1050px) 40vw, 27rem"
            imgClass="photo--editorial"
          />
        </figure>
      )}

      <div class="headshot-faq__content">
        <header class="headshot-faq__heading">
          <span class="headshot-rule" aria-hidden="true"></span>
          <h2 id={`${questions.id}-title`}>{questions.heading}</h2>
        </header>

        {questions.items?.length && (
          <div class="headshot-faq__list">
            {questions.items.map((item, index) => (
              <details class="headshot-faq__item" open={index === 0}>
                <summary>
                  <span class="headshot-faq__number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span
                    class="headshot-faq__question"
                    role="heading"
                    aria-level="3"
                  >
                    {item.heading}
                  </span>
                  <span class="headshot-faq__mark" aria-hidden="true"></span>
                </summary>
                <div class="headshot-faq__answer">
                  {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                  {item.links?.map((link) => (
                    <a
                      class="headshot-text-link"
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        )}

        {questions.links?.length && (
          <div class="headshot-links headshot-faq__links">
            {questions.links.map((link) => (
              <a
                class="headshot-text-link"
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  {page.finalCta && (
    <section
      class:list={["headshot-final", `tone-${page.finalCta.tone}`]}
      aria-labelledby="headshot-final-title"
    >
      {page.finalCta.image && (
        <div class="headshot-final__background" aria-hidden="true">
          <Picture
            src={page.finalCta.image}
            alt=""
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="100vw"
            imgClass="headshot-final__background-image"
          />
          <div class="headshot-final__wash" aria-hidden="true"></div>
        </div>
      )}

      {finalLeftPrint && (
        <figure
          class="headshot-print headshot-final__print headshot-final__print--left"
          aria-hidden="true"
        >
          <Picture
            src={finalLeftPrint}
            alt=""
            loading="lazy"
            decoding="async"
            optimizedMobileWidth={400}
            optimizedDesktopWidth={640}
            imgClass="photo--editorial"
          />
        </figure>
      )}

      <div class="headshot-shell headshot-final__inner">
        <div class="headshot-final__copy">
          {page.finalCta.eyebrow && (
            <p class="headshot-final__eyebrow">{page.finalCta.eyebrow}</p>
          )}
          <h2 id="headshot-final-title">{page.finalCta.heading}</h2>
          {page.finalCta.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {page.finalCta.link && (
            <a
              class="outline-button"
              href={page.finalCta.link.href}
              target={page.finalCta.link.external ? "_blank" : undefined}
              rel={page.finalCta.link.external ? "noopener noreferrer" : undefined}
            >
              {page.finalCta.link.label}
            </a>
          )}
        </div>
      </div>

      {finalRightPrint && (
        <figure
          class="headshot-print headshot-final__print headshot-final__print--right"
          aria-hidden="true"
        >
          <Picture
            src={finalRightPrint}
            alt=""
            loading="lazy"
            decoding="async"
            optimizedMobileWidth={400}
            optimizedDesktopWidth={640}
            imgClass="photo--editorial"
          />
        </figure>
      )}
    </section>
  )}

  {faqSchema.length > 0 && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqSchema,
      })}
    />
  )}
</article>
