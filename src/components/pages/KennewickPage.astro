---
import type { EditorialPageData, PageSection } from "../../content/page-types";
import Picture from "../Picture.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/kennewick-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

const { page } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) throw new Error(`Kennewick page is missing the required section: ${id}`);
  return section;
};

const introduction = requireSection("minutes-away");
const spots = requireSection("kennewick-spots");
const directory = requireSection("kennewick-session-directory");
requireSection("recent-kennewick-sessions");
const questions = requireSection("kennewick-questions");

const spotItems = spots.items || [];
const serviceItems = directory.items || [];
const faqItems = questions.items || [];
const guideLink = spots.links?.find((link) =>
  link.href.includes("family-photo-locations-tri-cities"),
);

const faqSchema = faqItems
  .filter((item) => item.heading && item.paragraphs?.length)
  .map((item) => ({
    "@type": "Question",
    name: item.heading,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.paragraphs?.join(" "),
    },
  }));

const introLandscape =
  introduction.image || "/uploads/family-golden-hour-columbia-basin.jpg";
const introPrint =
  introduction.secondaryImage ||
  "/uploads/investment-lisa-photographing-outdoors-tricities.jpg";
const serviceArch =
  directory.image || "/uploads/maternity-waiting-to-welcome-tricities.jpg";
const servicePrint =
  directory.secondaryImage ||
  "/uploads/headshot-professional-formal-stairs-tricities.jpg";
const finalImage =
  page.finalCta?.image || "/uploads/family-portrait-outdoors-tricities.jpg";
---

<article
  class="kennewick-page"
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
>
  <EditorialHero
    pageKey="kennewick"
    titleId="kennewick-hero-title"
    heading={page.hero.heading}
    headingLines={["Your Kennewick, WA", "Photographer"]}
    scriptLine={page.hero.scriptLine || "this side of the river"}
    intro={page.hero.intro}
    backgroundImage={page.hero.image}
    backgroundAlt={page.hero.imageAlt}
    backgroundPosition="50% 54%"
    mobileBackgroundPosition="52% 49%"
    leftPrint={{
      src: "/uploads/family-with-baby-black-white-tricities.jpg",
      objectPosition: "50% 43%",
    }}
    rightPrint={{
      src: page.hero.secondaryImage || "/uploads/autumn-senior-portrait-tricities.jpg",
      objectPosition: "50% 41%",
    }}
    buttonLabel="Plan Your Kennewick Session"
    buttonTargetId="kennewick-final"
    paperEdgeColor="var(--color-weathered-sand)"
  />

  <section
    class:list={["kennewick-intro", `tone-${introduction.tone}`]}
    aria-labelledby={`${introduction.id}-title`}
  >
    <div class="kennewick-shell kennewick-intro__inner">
      <div class="kennewick-intro__copy">
        {introduction.eyebrow && (
          <p class="kennewick-eyebrow">{introduction.eyebrow}</p>
        )}
        <h2 id={`${introduction.id}-title`}>{introduction.heading}</h2>
        <div class="kennewick-prose">
          {introduction.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {/* CONTENT PENDING: "There's never a travel fee inside the Tri-Cities. Kennewick is home turf." remains unrendered until [VALIDAR — Q53] is confirmed. */}
        </div>
      </div>

      <div class="kennewick-intro__media">
        <span class="kennewick-intro__rule" aria-hidden="true"></span>
        <figure class="kennewick-intro__landscape">
          <Picture
            src={introLandscape}
            alt={introduction.imageAlt || "Family photographed outside during golden hour in the Columbia Basin"}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 88vw, (max-width: 1050px) 75vw, 45rem"
            imgClass="photo--editorial"
          />
        </figure>

        <figure class="kennewick-print kennewick-intro__print">
          <span class="kennewick-tape kennewick-tape--intro" aria-hidden="true"></span>
          <Picture
            src={introPrint}
            alt={introduction.secondaryImageAlt || "Lisa photographing a portrait session outdoors in the Tri-Cities"}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 45vw, (max-width: 1050px) 27vw, 18rem"
            imgClass="photo--editorial"
          />
        </figure>
      </div>
    </div>
  </section>

  <section
    class:list={["kennewick-spots", `tone-${spots.tone}`]}
    aria-labelledby={`${spots.id}-title`}
  >
    <div class="kennewick-shell">
      <header class="kennewick-spots__heading">
        <span class="kennewick-spots__index" aria-hidden="true">01—03</span>
        <h2 id={`${spots.id}-title`}>{spots.heading}</h2>
      </header>

      {/* CONTENT PENDING: [VALIDAR CON LISA: sus spots reales de Kennewick + 1–2 detalles de primera mano por locación]. Images are neutral Tri-Cities portfolio photographs and do not claim a Kennewick location. */}
      {spotItems.length > 0 && (
        <ol class="kennewick-spots__route">
          {spotItems.map((item, index) => (
            <li class:list={["kennewick-spot", `kennewick-spot--${index + 1}`]}>
              {item.image && (
                <figure class:list={["kennewick-spot__media", index === 1 && "kennewick-spot__media--arch", index === 2 && "kennewick-print"]}>
                  {index === 2 && (
                    <span class="kennewick-tape kennewick-tape--spot" aria-hidden="true"></span>
                  )}
                  <Picture
                    src={item.image}
                    alt={item.imageAlt || "Portrait photographed during a Tri-Cities session"}
                    loading="lazy"
                    decoding="async"
                    responsiveSrcset
                    sizes="(max-width: 767px) 82vw, (max-width: 1050px) 48vw, 36rem"
                    imgClass="photo--editorial"
                  />
                  <figcaption class="sr-only">
                    Tri-Cities portfolio photograph; exact Kennewick location attribution is pending.
                  </figcaption>
                </figure>
              )}

              <div class="kennewick-spot__copy">
                <span class="kennewick-spot__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {item.heading && <h3>{item.heading}</h3>}
                {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </li>
          ))}
        </ol>
      )}

      {guideLink && (
        <a class="kennewick-text-link kennewick-spots__guide" href={guideLink.href}>
          {guideLink.label}
        </a>
      )}
    </div>
  </section>

  <section
    class:list={["kennewick-services", `tone-${directory.tone}`]}
    aria-labelledby={`${directory.id}-title`}
  >
    <div class="kennewick-shell kennewick-services__inner">
      <div class="kennewick-services__media">
        <span class="kennewick-services__rule" aria-hidden="true"></span>
        <figure class="kennewick-services__arch">
          <Picture
            src={serviceArch}
            alt={directory.imageAlt || "Expecting mother photographed outside during a Tri-Cities portrait session"}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 75vw, (max-width: 1050px) 48vw, 32rem"
            imgClass="photo--editorial"
          />
        </figure>

        <figure class="kennewick-print kennewick-services__print">
          <span class="kennewick-tape kennewick-tape--services" aria-hidden="true"></span>
          <Picture
            src={servicePrint}
            alt={directory.secondaryImageAlt || "Professional portrait photographed on location in the Tri-Cities"}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) 43vw, (max-width: 1050px) 27vw, 18rem"
            imgClass="photo--editorial"
          />
        </figure>
      </div>

      <div class="kennewick-services__copy">
        <h2 id={`${directory.id}-title`} aria-label={directory.heading}>
          <span aria-hidden="true">Sessions I</span>
          <span aria-hidden="true">Photograph</span>
          <span aria-hidden="true">in Kennewick</span>
        </h2>

        {serviceItems.length > 0 && (
          <ol class="kennewick-services__list">
            {serviceItems.map((item, index) => {
              const link = item.links?.[0];
              return (
                <li>
                  <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  {link ? <a href={link.href}>{item.heading}</a> : <strong>{item.heading}</strong>}
                </li>
              );
            })}
          </ol>
        )}
      </div>
    </div>
  </section>

  {/* CONTENT PENDING: [PENDIENTE: 6–10 imágenes de sesiones reales en Kennewick con alt text de locación]. The “Recent Kennewick Sessions” gallery is intentionally unrendered; no generic portfolio imagery substitutes for local proof. */}

  <section
    class:list={["kennewick-faq", `tone-${questions.tone}`]}
    aria-labelledby={`${questions.id}-title`}
  >
    <div class="kennewick-shell kennewick-faq__inner">
      <header class="kennewick-faq__heading">
        <span class="kennewick-faq__label" aria-hidden="true">Questions · Kennewick</span>
        <h2 id={`${questions.id}-title`}>{questions.heading}</h2>
      </header>

      <div class="kennewick-faq__ledger">
        {/* CONTENT PENDING [Do you charge a travel fee to Kennewick?]: answer held until [VALIDAR — Q53]. */}
        {/* CONTENT PENDING [Where do senior sessions happen in Kennewick?]: exact locations and first-hand details require Lisa's approval. */}
        {faqItems.map((item, index) => (
          <details open={index === 0}>
            <summary>
              <span class="kennewick-faq__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              {item.heading && <h3>{item.heading}</h3>}
              <span class="kennewick-faq__mark" aria-hidden="true"></span>
            </summary>
            <div class="kennewick-faq__answer">
              {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {page.finalCta && (
    <section
      id="kennewick-final"
      class:list={["kennewick-final", `tone-${page.finalCta.tone}`]}
      aria-labelledby="kennewick-final-title"
      tabindex="-1"
    >
      <div class="kennewick-final__background" aria-hidden="true">
        <Picture
          src={finalImage}
          alt=""
          loading="lazy"
          decoding="async"
          responsiveSrcset
          sizes="100vw"
          imgClass="kennewick-final__background-image"
        />
        <div class="kennewick-final__wash"></div>
      </div>
      <div class="kennewick-shell kennewick-final__inner">
        <div class="kennewick-final__frame">
          <p class="kennewick-final__script" aria-hidden="true">find your light</p>
          <h2 id="kennewick-final-title">{page.finalCta.heading}</h2>
          {page.finalCta.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {page.finalCta.link && (
            <a class="outline-button" href={page.finalCta.link.href}>
              {page.finalCta.link.label}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {faqSchema.length > 0 && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqSchema,
      })}
    />
  )}
</article>
