---
import type {
  EditorialPageData,
  PageLink,
  PageSection,
} from "../../content/page-types";
import Picture from "../Picture.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/kennewick-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

interface RichPart {
  text: string;
  link?: PageLink;
  emphasis?: boolean;
}

const { page } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) throw new Error(`Kennewick page is missing the required section: ${id}`);
  return section;
};

const introduction = requireSection("minutes-away");
const style = requireSection("kennewick-style");
const setting = requireSection("kennewick-light");
const directory = requireSection("kennewick-session-directory");
const questions = requireSection("kennewick-questions");
const recent = page.sections.find(
  (section) => section.id === "recent-kennewick-sessions",
);

const serviceItems = directory.items || [];
const faqItems = (questions.items || []).filter(
  (item) => item.heading && item.paragraphs?.length,
);
const recentItems = recent?.items || [];
const hasRecentGallery = recentItems.length > 0;
const recentImagePaths = recentItems
  .map((item) => item.image?.trim())
  .filter((image): image is string => Boolean(image));
const heroAction = page.hero.links?.[0];
const heroHeadingLines = ["Kennewick, WA", "Photographer"];
const heroLeftPrint = "/uploads/kennewick-senior-riverside-portrait.jpg";
const heroRightPrint = "/uploads/kennewick-senior-wood-wall-portrait.jpg";

if (!heroAction?.label) {
  throw new Error("Kennewick hero is missing its local scroll action label");
}

if (
  serviceItems.length !== 5 ||
  serviceItems.some(
    (item) =>
      !item.heading ||
      !item.detail ||
      !item.links?.[0]?.href,
  )
) {
  throw new Error("Kennewick service directory requires five complete linked rows");
}

if (faqItems.length !== 4) {
  throw new Error("Kennewick FAQ requires four complete questions and answers");
}

if (
  hasRecentGallery &&
  (
    recentItems.length !== 5 ||
    !recent?.heading?.trim() ||
    recentItems.some(
      (item) =>
        !item.heading?.trim() ||
        !item.image?.trim() ||
        !item.imageAlt?.trim() ||
        Boolean(item.links?.length),
    ) ||
    new Set(recentImagePaths).size !== recentItems.length
  )
) {
  throw new Error(
    "Kennewick recent gallery requires exactly five complete items with unique images and no links",
  );
}

const richParts = (paragraph: string, links: PageLink[] = []): RichPart[] => {
  const availableLinks = links.filter(
    (link) => link.label && paragraph.includes(link.label),
  );
  const parts: RichPart[] = [];
  let cursor = 0;

  while (cursor < paragraph.length) {
    const nextLink = availableLinks
      .map((link) => ({
        index: paragraph.indexOf(link.label, cursor),
        end: paragraph.indexOf(link.label, cursor) + link.label.length,
        part: { text: link.label, link } satisfies RichPart,
      }))
      .filter(({ index }) => index >= cursor)
      .sort((a, b) => a.index - b.index)[0];

    const emphasisMatch = paragraph.slice(cursor).match(/\*([^*]+)\*/);
    const nextEmphasis = emphasisMatch && emphasisMatch.index !== undefined
      ? {
          index: cursor + emphasisMatch.index,
          end: cursor + emphasisMatch.index + emphasisMatch[0].length,
          part: { text: emphasisMatch[1], emphasis: true } satisfies RichPart,
        }
      : undefined;

    const next = [nextLink, nextEmphasis]
      .filter((candidate): candidate is NonNullable<typeof candidate> => Boolean(candidate))
      .sort((a, b) => a.index - b.index)[0];

    if (!next) {
      parts.push({ text: paragraph.slice(cursor) });
      break;
    }

    if (next.index > cursor) {
      parts.push({ text: paragraph.slice(cursor, next.index) });
    }
    parts.push(next.part);
    cursor = next.end;
  }

  return parts;
};

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  name: item.heading,
  acceptedAnswer: {
    "@type": "Answer",
    text: item.paragraphs?.join(" "),
  },
}));
---

<article
  class="kennewick-page"
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
>
  <!-- THESIS: verified Kennewick portrait work moves from atmosphere to local context, style, practical fit, services, questions, and one invitation. OWN-WORLD: the established editorial hero, warm tonal surfaces, square prints, arches, and hairlines. FIRST VIEWPORT: the shared service-page hero with exact H1, local intro, one scroll action, and two restrained prints. -->
  <EditorialHero
    pageKey="kennewick"
    titleId="kennewick-hero-title"
    heading={page.hero.heading}
    headingLines={heroHeadingLines}
    intro={page.hero.intro}
    backgroundImage={page.hero.image}
    backgroundAlt={page.hero.imageAlt}
    backgroundPosition="50% 50%"
    mobileBackgroundPosition="50% 48%"
    leftPrint={{ src: heroLeftPrint, objectPosition: "50% 40%" }}
    rightPrint={{ src: heroRightPrint, objectPosition: "58% 40%" }}
    paperEdgeColor="var(--color-weathered-sand)"
    buttonLabel={heroAction.label}
    buttonTargetId="kennewick-final"
  />

  <section
    id={introduction.id}
    class:list={["kennewick-intro", `tone-${introduction.tone}`]}
    aria-labelledby={`${introduction.id}-title`}
  >
    <div class="kennewick-intro__rule" aria-hidden="true"></div>
    <div class="kennewick-shell kennewick-intro__grid">
      {introduction.image && introduction.imageAlt && (
        <figure class="kennewick-intro__media">
          <Picture
            src={introduction.image}
            alt={introduction.imageAlt}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) min(82vw, 25rem), (max-width: 1050px) 40vw, 29rem"
            imgClass="photo--editorial"
          />
        </figure>
      )}

      <span class="kennewick-intro__line" aria-hidden="true"></span>

      <div class="kennewick-intro__copy">
        <h2 id={`${introduction.id}-title`}>{introduction.heading}</h2>
        <div class="kennewick-prose">
          {introduction.paragraphs?.map((paragraph) => (
            <p>
              {richParts(paragraph, introduction.links).map((part) =>
                part.link ? (
                  <a href={part.link.href}>{part.text}</a>
                ) : part.emphasis ? (
                  <em>{part.text}</em>
                ) : (
                  <Fragment>{part.text}</Fragment>
                ),
              )}
            </p>
          ))}
        </div>
      </div>

    </div>
  </section>

  <section
    id={style.id}
    class:list={["kennewick-style", `tone-${style.tone}`]}
    aria-labelledby={`${style.id}-title`}
  >
    <div class="kennewick-shell">
      <header class="kennewick-style__header">
        <h2 id={`${style.id}-title`}>{style.heading}</h2>
      </header>

      <div class="kennewick-style__grid">
        <div class="kennewick-prose kennewick-style__copy">
          {style.paragraphs?.map((paragraph) => (
            <p>
              {richParts(paragraph, style.links).map((part) =>
                part.link ? (
                  <a href={part.link.href}>{part.text}</a>
                ) : part.emphasis ? (
                  <em>{part.text}</em>
                ) : (
                  <Fragment>{part.text}</Fragment>
                ),
              )}
            </p>
          ))}
        </div>

        {(style.image || style.secondaryImage) && (
          <div class="kennewick-style__media">
            {style.image && style.imageAlt && (
              <figure class="kennewick-style__panorama">
                <Picture
                  src={style.image}
                  alt={style.imageAlt}
                  loading="lazy"
                  decoding="async"
                  responsiveSrcset
                  sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1050px) 56vw, 48rem"
                  imgClass="photo--editorial"
                />
              </figure>
            )}
            {style.secondaryImage && style.secondaryImageAlt && (
              <figure class="kennewick-style__arch">
                <Picture
                  src={style.secondaryImage}
                  alt={style.secondaryImageAlt}
                  loading="lazy"
                  decoding="async"
                  responsiveSrcset
                  sizes="(max-width: 767px) 60vw, (max-width: 1050px) 27vw, 22rem"
                  imgClass="photo--editorial"
                />
              </figure>
            )}
            <span class="kennewick-style__line" aria-hidden="true"></span>
          </div>
        )}
      </div>
    </div>
  </section>

  <section
    id={setting.id}
    class:list={["kennewick-setting", `tone-${setting.tone}`]}
    aria-labelledby={`${setting.id}-title`}
  >
    <div class="kennewick-shell kennewick-setting__grid">
      <header class="kennewick-setting__header">
        <h2 id={`${setting.id}-title`}>{setting.heading}</h2>
      </header>
      <div class="kennewick-prose kennewick-setting__copy">
        {setting.paragraphs?.map((paragraph) => (
          <p>
            {richParts(paragraph, setting.links).map((part) =>
              part.link ? (
                <a href={part.link.href}>{part.text}</a>
              ) : part.emphasis ? (
                <em>{part.text}</em>
              ) : (
                <Fragment>{part.text}</Fragment>
              ),
            )}
          </p>
        ))}
      </div>
    </div>
  </section>

  <section
    id={directory.id}
    class:list={["kennewick-directory", `tone-${directory.tone}`]}
    aria-labelledby={`${directory.id}-title`}
  >
    <div class="kennewick-shell kennewick-directory__layout">
      <div class="kennewick-directory__content">
        <header class="kennewick-directory__header">
          <h2 id={`${directory.id}-title`}>{directory.heading}</h2>
        </header>

        <nav aria-labelledby={`${directory.id}-title`}>
          <ul class="kennewick-directory__list">
          {serviceItems.map((item) => {
            const link = item.links![0];
            return (
              <li>
                <a class="kennewick-directory__row" href={link.href}>
                  <span class="kennewick-directory__name">{item.heading}</span>
                  <span class="kennewick-directory__detail">{item.detail}</span>
                  <span class="kennewick-directory__arrow" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      width="22"
                      height="22"
                      fill="none"
                      focusable="false"
                    >
                      <path
                        d="M7 17 17 7M8 7h9v9"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      ></path>
                    </svg>
                  </span>
                </a>
              </li>
            );
          })}
          </ul>
        </nav>
      </div>

      {directory.image && directory.imageAlt && (
        <figure class="kennewick-directory__media">
          <Picture
            src={directory.image}
            alt={directory.imageAlt}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1050px) 42vw, 34rem"
            imgClass="photo--editorial"
          />
        </figure>
      )}

      <span class="kennewick-directory__line" aria-hidden="true"></span>
    </div>
  </section>

  {recent && hasRecentGallery && (
    <section
      id={recent.id}
      class:list={["kennewick-recent", `tone-${recent.tone}`]}
      aria-labelledby={`${recent.id}-title`}
    >
      <div class="kennewick-shell">
        <h2 id={`${recent.id}-title`}>{recent.heading}</h2>
        <div class="kennewick-recent__gallery">
          {recentItems.map((item, index) => (
            <figure
              class:list={[
                "kennewick-recent__photo",
                index === 0 && "kennewick-recent__photo--featured",
              ]}
            >
              <Picture
                src={item.image!}
                alt={item.imageAlt!}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes={index === 0
                  ? "(max-width: 767px) calc(100vw - 2rem), (max-width: 1050px) calc(100vw - 5rem), 55rem"
                  : "(max-width: 767px) calc(100vw - 2rem), (max-width: 1050px) 45vw, 26rem"}
                imgClass="photo--editorial"
              />
              <figcaption>{item.heading}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section
    id={questions.id}
    class:list={["kennewick-faq", `tone-${questions.tone}`]}
    aria-labelledby={`${questions.id}-title`}
  >
    <div class="kennewick-shell kennewick-faq__grid">
      <header class="kennewick-faq__header">
        <h2 id={`${questions.id}-title`}>{questions.heading}</h2>
      </header>

      <div class="kennewick-faq__list">
        {faqItems.map((item, index) => (
          <details open={index === 0}>
            <summary>
              <h3 class="kennewick-faq__question">{item.heading}</h3>
              <span class="kennewick-faq__mark" aria-hidden="true"></span>
            </summary>
            <div class="kennewick-faq__answer">
              {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {page.finalCta && (
    <section
      id="kennewick-final"
      class:list={["kennewick-final", `tone-${page.finalCta.tone}`]}
      aria-labelledby="kennewick-final-title"
      tabindex="-1"
    >
      {page.finalCta.image && page.finalCta.imageAlt && (
          <figure class="kennewick-final__background">
            <Picture
              src={page.finalCta.image}
              alt={page.finalCta.imageAlt}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="100vw"
              imgClass="kennewick-final__background-image"
            />
          </figure>
      )}
      <div class="kennewick-final__wash" aria-hidden="true"></div>
      <div class="kennewick-final__frame" aria-hidden="true"></div>
      <div class="kennewick-shell kennewick-final__grid">
        <div class="kennewick-final__copy">
          <h2 id="kennewick-final-title">{page.finalCta.heading}</h2>
          {page.finalCta.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {page.finalCta.link && (
            <a class="outline-button" href={page.finalCta.link.href}>
              {page.finalCta.link.label}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": "https://www.itsakeeperphotography.com/kennewick-wa-photographer/#faq",
      mainEntity: faqSchema,
    })}
  />
</article>
