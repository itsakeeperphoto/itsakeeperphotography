---
import type { EditorialPageData, PageSection } from "../../content/page-types";
import Picture from "../Picture.astro";
import EditorialHero from "./EditorialHero.astro";
import "../../styles/newborn-page.css";

interface Props {
  page: EditorialPageData;
  settings: any;
  inquiry?: any;
}

const { page } = Astro.props;

const requireSection = (id: string): PageSection => {
  const section = page.sections.find((candidate) => candidate.id === id);
  if (!section) throw new Error(`Newborn page is missing the required section: ${id}`);
  return section;
};

const firstDays = requireSection("those-first-days");
const babyLed = requireSection("baby-led-sessions");
const process = requireSection("newborn-session-process");
const booking = requireSection("when-to-book");
const growing = requireSection("growing-families");
const questions = requireSection("newborn-session-questions");

const processItems = process.items || [];
const bookingStatement = booking.items?.[0];
const growingLink = growing.links?.[0];
const [heroHeadingLead, heroHeadingTail] = page.hero.heading.split(" in ");
const heroHeadingLines = [
  heroHeadingLead.replace("Photographer", "Photo\u200bgrapher"),
  ...(heroHeadingTail ? [`in ${heroHeadingTail}`] : []),
];

const faqSchema = (questions.items || [])
  .filter((item) => item.heading && item.paragraphs?.length)
  .map((item) => ({
    "@type": "Question",
    name: item.heading,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.paragraphs?.join(" "),
    },
  }));
---

<article
  class="newborn-page"
  data-content-status={page.contentStatus}
  data-signature-device={page.signature}
>
  <EditorialHero
    pageKey="newborn"
    titleId="newborn-hero-title"
    heading={page.hero.heading}
    headingLines={heroHeadingLines}
    scriptLine={page.hero.scriptLine || ""}
    intro={page.hero.intro}
    links={page.hero.links}
    backgroundImage={page.hero.image}
    backgroundAlt={page.hero.imageAlt}
    backgroundPosition="50% 50%"
    mobileBackgroundPosition="57% 50%"
    leftPrint={{
      src: page.hero.secondaryImage,
      objectPosition: "50% 45%",
    }}
    rightPrint={{
      src: babyLed.secondaryImage,
      objectPosition: "50% 48%",
    }}
    paperEdgeColor="var(--color-warm-ivory)"
  />

  <section
    class:list={["newborn-short-answer", `tone-${babyLed.tone}`]}
    aria-labelledby={`${babyLed.id}-title`}
  >
    <div class="newborn-shell newborn-short-answer__inner">
      <div class="newborn-short-answer__copy">
        <span class="newborn-rule" aria-hidden="true"></span>
        <h2 id={`${babyLed.id}-title`}>{babyLed.heading}</h2>
        <div class="newborn-prose">
          {babyLed.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      {babyLed.image && (
        <figure class="newborn-short-answer__photo">
          <Picture
            src={babyLed.image}
            alt={babyLed.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) calc(100vw - 3rem), (max-width: 1050px) 46vw, 34rem"
            imgClass="photo--editorial"
          />
        </figure>
      )}
    </div>
  </section>

  <section
    class:list={["newborn-these-days", `tone-${firstDays.tone}`]}
    aria-labelledby={`${firstDays.id}-title`}
  >
    <div class="newborn-shell newborn-these-days__inner">
      {firstDays.image && (
        <figure class="newborn-these-days__arch">
          <Picture
            src={firstDays.image}
            alt={firstDays.imageAlt || ""}
            loading="lazy"
            decoding="async"
            responsiveSrcset
            sizes="(max-width: 767px) min(82vw, 22rem), (max-width: 1050px) 36vw, 25rem"
            imgClass="photo--editorial"
          />
        </figure>
      )}

      <div class="newborn-these-days__copy">
        <span class="newborn-rule" aria-hidden="true"></span>
        <h2 id={`${firstDays.id}-title`}>{firstDays.heading}</h2>
        <div class="newborn-prose">
          {firstDays.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section
    class:list={["newborn-process", `tone-${process.tone}`]}
    aria-labelledby={`${process.id}-title`}
  >
    <div class="newborn-shell newborn-process__inner">
      <header class="newborn-process__heading">
        <span class="newborn-rule" aria-hidden="true"></span>
        <h2 id={`${process.id}-title`}>{process.heading}</h2>
      </header>

      {processItems.length > 0 && (
        <ol class="newborn-process__triptych">
          {processItems.map((item, index) => (
            <li class:list={["newborn-process__item", { "newborn-process__item--arch": index === 1 }]}>
              <div class="newborn-process__image-row">
                {index === 1 && process.eyebrow && (
                  <svg
                    class="newborn-process__arc-copy"
                    viewBox="0 0 360 118"
                    role="presentation"
                    aria-hidden="true"
                  >
                    <defs>
                      <path id="newborn-process-arc" d="M 28 102 A 154 154 0 0 1 332 102"></path>
                    </defs>
                    <text dy="-10">
                      <textPath href="#newborn-process-arc" startOffset="50%" text-anchor="middle">
                        {process.eyebrow.toUpperCase()}
                      </textPath>
                    </text>
                  </svg>
                )}
                {item.image && (
                  <figure class="newborn-process__photo">
                    <Picture
                      src={item.image}
                      alt={item.imageAlt || ""}
                      loading="lazy"
                      decoding="async"
                      responsiveSrcset
                      sizes="(max-width: 767px) 82vw, (max-width: 1050px) 30vw, 23rem"
                      imgClass="photo--editorial"
                    />
                  </figure>
                )}
              </div>
              <div class="newborn-process__copy">
                <span class="newborn-process__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  {item.heading && <h3>{item.heading}</h3>}
                  {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </div>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <section
    class:list={["newborn-booking", `tone-${booking.tone}`]}
    aria-labelledby={`${booking.id}-title`}
  >
    <div class="newborn-shell newborn-booking__inner">
      <header class="newborn-booking__heading">
        <span class="newborn-rule" aria-hidden="true"></span>
        <h2 id={`${booking.id}-title`}>{booking.heading}</h2>
      </header>

      <div class="newborn-booking__spread">
        <div class="newborn-booking__statement">
          {bookingStatement?.heading && <h3>{bookingStatement.heading}</h3>}
          {booking.image && (
            <figure class="newborn-booking__photo">
              <Picture
                src={booking.image}
                alt={booking.imageAlt || ""}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) min(76vw, 21rem), (max-width: 1050px) 34vw, 23rem"
                imgClass="photo--editorial"
              />
            </figure>
          )}
        </div>

        <div class="newborn-booking__copy">
          <div class="newborn-prose">
            {bookingStatement?.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          {booking.links?.[0] && (
            <a class="newborn-text-link" href={booking.links[0].href}>
              {booking.links[0].label}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section
    class:list={["newborn-archive", `tone-${growing.tone}`]}
    aria-labelledby={`${growing.id}-title`}
  >
    <div class="newborn-shell newborn-archive__inner">
      <div class="newborn-archive__copy">
        <span class="newborn-rule" aria-hidden="true"></span>
        <h2 id={`${growing.id}-title`}>{growing.heading}</h2>
        <div class="newborn-prose">
          <p>{growing.paragraphs?.[0]}{growingLink && (
            <a href={growingLink.href}>{growingLink.label}</a>
          )}{growing.paragraphs?.[1]}</p>
          {growing.paragraphs?.[2] && <p>{growing.paragraphs[2]}</p>}
        </div>
      </div>

      {(growing.image || growing.secondaryImage) && (
        <div class="newborn-archive__media">
          {growing.image && (
            <figure class="newborn-archive__photo newborn-archive__photo--primary">
              <Picture
                src={growing.image}
                alt={growing.imageAlt || ""}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) 72vw, (max-width: 1050px) 32vw, 22rem"
                imgClass="photo--editorial"
              />
            </figure>
          )}
          {growing.secondaryImage && (
            <figure class="newborn-archive__photo newborn-archive__photo--secondary">
              <Picture
                src={growing.secondaryImage}
                alt={growing.secondaryImageAlt || ""}
                loading="lazy"
                decoding="async"
                responsiveSrcset
                sizes="(max-width: 767px) 52vw, (max-width: 1050px) 23vw, 15rem"
                imgClass="photo--editorial"
              />
            </figure>
          )}
        </div>
      )}
    </div>
  </section>

  <section
    class:list={["newborn-questions", `tone-${questions.tone}`]}
    aria-labelledby={`${questions.id}-title`}
  >
    <div class="newborn-shell newborn-questions__inner">
      <header class="newborn-questions__heading">
        <span class="newborn-rule" aria-hidden="true"></span>
        <h2 id={`${questions.id}-title`}>{questions.heading}</h2>
      </header>

      {questions.items?.length && (
        <div class="newborn-questions__list">
          {questions.items.map((item, index) => (
            <details class="newborn-questions__item" open={index === 0}>
              <summary>
                <span class="newborn-questions__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="newborn-questions__question" role="heading" aria-level="3">
                  {item.heading}
                </span>
                <span class="newborn-questions__mark" aria-hidden="true"></span>
              </summary>
              <div class="newborn-questions__answer">
                {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </details>
          ))}
        </div>
      )}
    </div>
  </section>

  {page.finalCta && (
    <section
      class:list={["newborn-final", `tone-${page.finalCta.tone}`]}
      aria-labelledby="newborn-final-title"
    >
      <div class="newborn-final__inner">
        <div class="newborn-final__copy">
          <span class="newborn-rule" aria-hidden="true"></span>
          <h2 id="newborn-final-title">{page.finalCta.heading}</h2>
          {page.finalCta.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {page.finalCta.link && (
            <a class="outline-button" href={page.finalCta.link.href}>
              {page.finalCta.link.label}
            </a>
          )}
        </div>
        {page.finalCta.image && (
          <figure class="newborn-final__photo">
            <Picture
              src={page.finalCta.image}
              alt={page.finalCta.imageAlt || ""}
              loading="lazy"
              decoding="async"
              responsiveSrcset
              sizes="(max-width: 767px) 100vw, 55vw"
              imgClass="photo--editorial"
            />
          </figure>
        )}
      </div>
    </section>
  )}

  {faqSchema.length > 0 && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqSchema,
      })}
    />
  )}
</article>
