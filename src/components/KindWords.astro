---
import { tinaField } from "@tinacms/astro/tina-field";
import Picture from "./Picture.astro";

interface Props {
  kindWords: any;
  settings: any;
  testimonials?: any[];
  summaryAsLink?: boolean;
  showReviewAction?: boolean;
}

const {
  kindWords,
  settings,
  testimonials = [],
  summaryAsLink = true,
  showReviewAction = false,
} = Astro.props;
const reviewActionHref = String(settings?.social?.googleProfile || "").trim();
const hasReviewAction = showReviewAction && reviewActionHref.length > 0;
const cardTilts = ["-0.7deg", "0.45deg", "-0.35deg", "0.65deg", "-0.5deg", "0.3deg"];
---

<section
  class="kind-words"
  id="kind-words"
  aria-labelledby="kind-words-title"
  data-tina-field={tinaField(kindWords)}
>
  <div class="content-shell kind-words__header">
    <div class="section-intro">
      <p class="section-eyebrow" data-tina-field={tinaField(kindWords, "eyebrow")}>
        {kindWords.eyebrow}
      </p>
      <h2
        class="section-heading"
        id="kind-words-title"
        data-tina-field={tinaField(kindWords, "heading")}
      >{kindWords.heading}</h2>
    </div>
  </div>

  <review-polaroids class="kind-words__archive" data-review-archive>
    <svg
      class="kind-words__wire"
      viewBox="0 0 1000 96"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        class="kind-words__wire-path kind-words__wire-path--desktop"
        d="M 0 14 Q 500 143 1000 14"
      ></path>
      <path
        class="kind-words__wire-path kind-words__wire-path--compact"
        d="M 0 14 Q 500 98 1000 14"
      ></path>
    </svg>

    <div
      class="kind-words__rail"
      data-review-rail
      tabindex="0"
      role="region"
      aria-label="Client review photographs. Scroll horizontally to explore all reviews."
    >
      <div class="kind-words__track">
        <div class="kind-words__group" data-review-group>
          {testimonials.map((testimonial, index) => {
            return (
              <article
                class="review-polaroid"
                style={`--review-tilt: ${cardTilts[index % cardTilts.length]};`}
                tabindex="0"
                aria-label={`${testimonial.sessionType} client review${testimonial.name ? ` from ${testimonial.name}` : ""}`}
                data-review-card
                data-review-state="front"
                data-review-index={String(index + 1)}
                data-review-name={testimonial.name?.trim() || undefined}
                data-tina-field={tinaField(testimonial)}
              >
                <img
                  class="review-polaroid__hanger"
                  src="/uploads/bronze-paper-clip.png"
                  width="192"
                  height="161"
                  alt=""
                  loading="eager"
                  decoding="async"
                  aria-hidden="true"
                />

                <div class="review-polaroid__scene">
                  <div class="review-polaroid__flipper" data-review-flipper>
                    <figure class="review-polaroid__face review-polaroid__front" data-review-front>
                      <Picture
                        src={testimonial.image}
                        alt={testimonial.imageAlt}
                        pictureClass="review-polaroid__picture"
                        imgClass="review-polaroid__image"
                        loading="lazy"
                        decoding="async"
                        sizes="(max-width: 479px) calc(100vw - 48px), (max-width: 1050px) 320px, 288px"
                        responsiveSrcset={true}
                        dataTinaField={tinaField(testimonial, "image")}
                      />
                      <figcaption>
                        <span>{testimonial.sessionType}</span>
                        <small>Photographed by Lisa</small>
                      </figcaption>
                    </figure>

                    <div
                      class="review-polaroid__face review-polaroid__back"
                      aria-hidden="true"
                      inert
                      data-review-back
                    >
                      <p class="review-polaroid__rating">
                        <span class="sr-only">5 out of 5 stars.</span>
                        <span aria-hidden="true">★★★★★</span>
                      </p>

                      <div
                        class="review-polaroid__quote-scroll"
                        data-review-scroll
                        data-review-scroll-label={`Full ${testimonial.sessionType} review`}
                      >
                        <blockquote>
                          <p>{testimonial.quote}</p>
                        </blockquote>
                      </div>

                      <p class="review-polaroid__attribution">
                        {testimonial.name?.trim() && <strong>{testimonial.name}</strong>}
                        <span>{testimonial.sessionType}</span>
                        <small hidden data-review-scroll-cue>Scroll to finish</small>
                      </p>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </div>
  </review-polaroids>

  {kindWords.reviewsLine && (
    <p class="kind-words__google content-shell">
      {summaryAsLink && kindWords.buttonHref ? (
        <a
          href={kindWords.buttonHref}
          aria-label={`${kindWords.reviewsLine} for ${settings.businessName}`}
          data-google-review-summary
          data-google-review-summary-endpoint="/api/google-review-summary"
          data-business-name={settings.businessName}
          data-tina-field={tinaField(kindWords, "reviewsLine")}
        >{kindWords.reviewsLine}</a>
      ) : (
        <span
          aria-live="polite"
          data-google-review-summary
          data-google-review-summary-endpoint="/api/google-review-summary"
          data-business-name={settings.businessName}
          data-tina-field={tinaField(kindWords, "reviewsLine")}
        >{kindWords.reviewsLine}</span>
      )}
      {hasReviewAction && (
        <a
          class="outline-button kind-words__review-button"
          href={reviewActionHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Leave us a review on Google (opens in a new tab)"
          data-review-action
        >
          <span>Leave us a review</span>
          <svg viewBox="0 0 34 18" aria-hidden="true" focusable="false">
            <path d="M1 9h30M23 1l8 8-8 8"></path>
          </svg>
        </a>
      )}
    </p>
  )}
</section>

<script>
  const refreshGoogleReviewSummaries = () => {
    document.querySelectorAll<HTMLElement>("[data-google-review-summary]").forEach((reviewSummary) => {
      if (reviewSummary.dataset.googleReviewSummaryBound === "true") return;
      reviewSummary.dataset.googleReviewSummaryBound = "true";
      const endpoint = reviewSummary.dataset.googleReviewSummaryEndpoint;
      const businessName = reviewSummary.dataset.businessName;

      if (endpoint) {
        fetch(endpoint, {
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        })
          .then((response) => (response.ok ? response.json() : null))
          .then((summary) => {
            const totalReviewCount = summary?.totalReviewCount;
            const averageRating = summary?.averageRating;
            if (
              !Number.isSafeInteger(totalReviewCount) ||
              totalReviewCount < 0 ||
              !Number.isFinite(averageRating) ||
              averageRating < 0 ||
              averageRating > 5
            ) return;

            const formattedCount = new Intl.NumberFormat("en-US").format(totalReviewCount);
            const reviewNoun = totalReviewCount === 1 ? "review" : "reviews";
            const formattedRating = new Intl.NumberFormat("en-US", {
              minimumFractionDigits: 1,
              maximumFractionDigits: 1,
            }).format(averageRating);
            const label = `${formattedRating} out of 5 from ${formattedCount} Google ${reviewNoun}`;

            reviewSummary.textContent = label;
            reviewSummary.setAttribute(
              "aria-label",
              businessName ? `${label} for ${businessName}` : label
            );
          })
          .catch(() => {
            // The server-rendered summary remains usable when the cached summary is unavailable.
          });
      }
    });
  };

  refreshGoogleReviewSummaries();

  const root = document.documentElement;
  if (root.dataset.googleReviewObserver !== "true") {
    root.dataset.googleReviewObserver = "true";
    let refreshFrame = 0;
    const observer = new MutationObserver((records) => {
      const replacedIsland = records.some(
        (record) =>
          record.type === "childList" &&
          record.target instanceof Element &&
          record.target.matches("[data-tina-island]"),
      );
      if (!replacedIsland || refreshFrame) return;
      refreshFrame = window.requestAnimationFrame(() => {
        refreshFrame = 0;
        refreshGoogleReviewSummaries();
      });
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }
</script>
