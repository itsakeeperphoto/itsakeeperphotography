---
import Base from "../layouts/Base.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import EditorialPageRouter from "../components/pages/EditorialPageRouter.astro";
import SiteShell from "../components/SiteShell.astro";
import { getContentPage } from "../lib/content-pages";
import { topLevelEditorialManifest } from "../lib/page-manifest";
import { getStaticHomepagePage } from "../lib/static-content";
import { absoluteUrl, siteOrigin } from "../lib/site-environment";
import { contentPageWrapper } from "../lib/tina/wrappers";
import aboutStylesheet from "../styles/about-page.css?url";
import pascoStylesheet from "../styles/pasco-page.css?url";

export function getStaticPaths() {
  return topLevelEditorialManifest.map((entry) => ({
    params: { slug: entry.path.split("/").filter(Boolean)[0] },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const page = getContentPage(entry.contentPath);
const shared = getStaticHomepagePage();
const { homepage, settings } = shared.data;
const canonical = absoluteUrl(entry.path);
const pageStylesheet = entry.id === "about"
  ? aboutStylesheet
  : entry.id === "pasco"
    ? pascoStylesheet
    : undefined;
const directionContract = entry.id === "about"
  ? `THESIS: Lisa's About page is a keeper archive of why and how she photographs; it refuses generic credential cards.
OWN-WORLD: Warm ivory, sand, olive, walnut and umber fields; arched portraits, square prints and one-pixel ledgers; no badges or decorative shadows.
STORY: Her children begin the work, the name and camera open the door, twenty years shape the method, and verified recognition earns the inquiry.
FIRST VIEWPORT: The existing hero remains exact; below its torn edge, Lisa's portrait arch faces the origin story and one line resolves into the name ledger.
FORM: User-approved A+C — Keeper Archive plus Through Her Lens — pinned 2026-08-10.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`
  : undefined;
const detailedService =
  entry.id === "family"
    ? {
        name: "Family Photography",
        breadcrumbName: "Family Photography",
        serviceType: "Outdoor family portrait photography",
        description:
          "Relaxed golden-hour family photography sessions in the Tri-Cities, directed through activities and prompts rather than static posing, with wardrobe guidance and planning included.",
      }
    : entry.id === "seniors"
      ? {
          name: "Senior Pictures",
          breadcrumbName: "Senior Pictures",
          serviceType: "High school senior portrait photography",
          description:
            "Senior portrait sessions in the Tri-Cities photographed at golden hour across multiple locations in one evening, with wardrobe planning and full posing guidance included.",
        }
      : entry.id === "newborn"
        ? {
            name: "Newborn Photography",
            breadcrumbName: "Newborn Photography",
            serviceType: "In-home newborn and baby photography",
            description:
              "Gentle, unhurried in-home newborn photography sessions photographed at the baby's pace using natural light, without props or studio setups. Serving Richland, Kennewick and Pasco, Washington.",
          }
      : entry.id === "headshots"
        ? {
            name: "Professional Headshots",
            breadcrumbName: "Professional Headshots",
            serviceType: "On-location professional and team headshot photography",
            description:
              "Professional headshots photographed on location at the client's workplace using portable studio lighting and backdrops. Individual and full-team sessions available across Richland, Kennewick and Pasco, Washington.",
          }
        : entry.id === "branding"
          ? {
              name: "Branding Photography",
              breadcrumbName: "Branding Photography",
              serviceType:
                "Custom business and personal branding photography",
              description:
                "Custom business photography sessions producing a full library of brand images — portraits, work in progress, workspace and product details — with commercial usage rights included. Serving Richland, Kennewick and Pasco, Washington.",
            }
          : null;
const detailedServiceId = `${canonical}#service`;
const investmentBreadcrumbSchema =
  entry.id === "investment"
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "@id": `${canonical}#breadcrumb`,
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${siteOrigin}/`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Investment",
            item: canonical,
          },
        ],
      }
    : null;
const contactBreadcrumbSchema =
  entry.id === "contact"
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "@id": `${canonical}#breadcrumb`,
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${siteOrigin}/`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Session Pricing Estimate",
            item: canonical,
          },
        ],
      }
    : null;
const cityPageDetails =
  entry.id === "richland"
    ? { city: "Richland", breadcrumb: "Richland Photographer" }
    : entry.id === "kennewick"
      ? { city: "Kennewick", breadcrumb: "Kennewick Photographer" }
      : entry.id === "pasco"
        ? { city: "Pasco", breadcrumb: "Pasco Photographer" }
        : null;
const citySpatialCoverage =
  cityPageDetails
    ? {
        "@type": "City",
        name: cityPageDetails.city,
        containedInPlace: { "@type": "State", name: "Washington" },
      }
    : undefined;
const cityBreadcrumbSchema =
  cityPageDetails
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "@id": `${canonical}#breadcrumb`,
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${siteOrigin}/`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: cityPageDetails.breadcrumb,
            item: canonical,
          },
        ],
      }
    : null;
const cityServiceDetails =
  entry.id === "kennewick"
    ? { city: "Kennewick", name: "Kennewick Portrait Photography" }
    : entry.id === "pasco"
      ? { city: "Pasco", name: "Pasco Portrait Photography" }
      : null;
const cityServiceSchema =
  cityServiceDetails
    ? {
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": `${canonical}#service`,
        name: cityServiceDetails.name,
        serviceType: "Portrait photography",
        provider: { "@id": `${siteOrigin}/#business` },
        areaServed: {
          "@type": "City",
          name: cityServiceDetails.city,
          containedInPlace: { "@type": "State", name: "Washington" },
        },
        url: canonical,
        mainEntityOfPage: { "@id": `${canonical}#webpage` },
      }
    : null;
const aboutPersonId = `${siteOrigin}/#lisa`;
const aboutPersonSchema =
  entry.id === "about"
    ? {
        "@context": "https://schema.org",
        "@type": "Person",
        "@id": aboutPersonId,
        name: "Lisa Weiss",
        jobTitle: "Professional Photographer",
        description:
          "Professional senior, family and newborn photographer based in Richland, Washington, with over 20 years behind the camera and 14 years in business serving the Tri-Cities.",
        worksFor: { "@id": `${siteOrigin}/#business` },
        homeLocation: {
          "@type": "Place",
          name: "Richland, Washington",
          address: {
            "@type": "PostalAddress",
            addressLocality: "Richland",
            addressRegion: "WA",
            addressCountry: "US",
          },
        },
        knowsAbout: [
          "senior portrait photography",
          "family photography",
          "newborn photography",
          "branding photography",
          "professional headshots",
          "natural light photography",
          "golden hour portraiture",
        ],
        knowsLanguage: "en",
        sameAs: [settings.social.instagram, settings.social.facebook].filter(Boolean),
        subjectOf: {
          "@type": "Article",
          name: "Cover feature: Lisa Weiss",
          isPartOf: {
            "@type": "Periodical",
            name: "Tri-Cities MOM Magazine",
          },
          datePublished: "2019-08",
          url: "https://issuu.com/wpdigitalpublications/docs/tri_final2_augsept_19-july30_issuu",
        },
      }
    : null;
const aboutBreadcrumbSchema =
  entry.id === "about"
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "@id": `${canonical}#breadcrumb`,
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${siteOrigin}/`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "About Lisa",
            item: canonical,
          },
        ],
      }
    : null;
const detailedFaqSchema =
  entry.id === "branding"
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "@id": `${canonical}#faq`,
        mainEntity: [
          {
            "@type": "Question",
            name: "What's the difference between branding photos and headshots?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "A headshot is one polished portrait. Branding photography is a full library covering the person, their work, their space and their product details. Branding sessions include headshots.",
            },
          },
          {
            "@type": "Question",
            name: "Can branding photos be used for advertising?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Yes. Branding sessions include commercial usage rights, which is what distinguishes them from personal sessions that carry personal print rights only.",
            },
          },
          {
            "@type": "Question",
            name: "Where do branding sessions take place?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Usually at the client's place of business in Richland, Kennewick or Pasco, or at Tri-Cities locations chosen to match the brand.",
            },
          },
          {
            "@type": "Question",
            name: "How often should branding photos be updated?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Most businesses refresh branding images once or twice a year. Headshots typically last two to three years.",
            },
          },
        ],
      }
    : null;
const detailedAdditionalSchema = detailedService
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": detailedServiceId,
        name: detailedService.name,
        serviceType: detailedService.serviceType,
        description: detailedService.description,
        provider: { "@id": `${siteOrigin}/#business` },
        areaServed: [
          {
            "@type": "City",
            name: "Richland",
            containedInPlace: { "@type": "State", name: "Washington" },
          },
          { "@type": "City", name: "Kennewick" },
          { "@type": "City", name: "Pasco" },
        ],
        url: canonical,
        mainEntityOfPage: { "@id": `${canonical}#webpage` },
      },
      ...(detailedFaqSchema ? [detailedFaqSchema] : []),
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "@id": `${canonical}#breadcrumb`,
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${siteOrigin}/`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: detailedService.breadcrumbName,
            item: canonical,
          },
        ],
      },
    ]
  : aboutPersonSchema && aboutBreadcrumbSchema
    ? [aboutPersonSchema, aboutBreadcrumbSchema]
    : investmentBreadcrumbSchema
      ? [investmentBreadcrumbSchema]
      : contactBreadcrumbSchema
        ? [contactBreadcrumbSchema]
        : cityBreadcrumbSchema
          ? [...(cityServiceSchema ? [cityServiceSchema] : []), cityBreadcrumbSchema]
          : [];
const pageSchemaExtra = entry.id === "about"
  ? {
      about: { "@id": aboutPersonId },
      mainEntity: { "@id": aboutPersonId },
    }
  : undefined;
---

<Base
  title={page.title}
  description={page.description}
  settings={settings}
  canonicalPath={entry.path}
  seoImage={page.hero.image}
  seoImageAlt={page.hero.imageAlt}
  searchVisibility={entry.searchVisibility}
  schemaType={detailedService ? "WebPage" : entry.schemaType}
  additionalSchema={detailedAdditionalSchema}
  pageSpatialCoverage={citySpatialCoverage}
  pageSchemaExtra={pageSchemaExtra}
  loadEditorialMotion={entry.id === "contact"}
  pageStylesheet={pageStylesheet}
  directionContract={directionContract}
  founderReferenceOnly={entry.id === "about"}
>
  <SiteShell settings={settings} homepage={homepage} currentPath={entry.path}>
    <TinaIsland name="contentPage" wrapper={contentPageWrapper} params={{ path: entry.contentPath }} primary>
      <EditorialPageRouter page={page} settings={settings} inquiry={homepage.inquiry} />
    </TinaIsland>
  </SiteShell>
</Base>
