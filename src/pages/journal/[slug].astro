---
import Base from "../../layouts/Base.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import ContentPage from "../../components/pages/ContentPage.astro";
import LocationsGuidePage from "../../components/pages/LocationsGuidePage.astro";
import SiteShell from "../../components/SiteShell.astro";
import { getContentPage } from "../../lib/content-pages";
import { journalArticleManifest } from "../../lib/page-manifest";
import { absoluteUrl, siteOrigin } from "../../lib/site-environment";
import { getStaticHomepagePage } from "../../lib/static-content";
import { contentPageWrapper } from "../../lib/tina/wrappers";

export function getStaticPaths() {
  return journalArticleManifest.map((entry) => ({
    params: { slug: entry.path.split("/").filter(Boolean).at(-1) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const page = getContentPage(entry.contentPath);
const shared = getStaticHomepagePage();
const { homepage, settings } = shared.data;
const isLocationsGuide = entry.id === "locations-guide";
const locationsCanonical = absoluteUrl(entry.path);
const locationsArticleImage = new URL(
  page.hero.image || settings.seoImage,
  `${siteOrigin}/`,
).toString();

const locationsQuestions = isLocationsGuide
  ? page.sections.find((section) => section.id === "location-questions")?.items || []
  : [];
const locationsFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: locationsQuestions.map((item) => ({
    "@type": "Question",
    name: item.heading,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.paragraphs?.join(" "),
    },
  })),
};
const locationsArticleSchemaExtra = {
  headline: page.title,
  author: { "@id": `${siteOrigin}/#lisa` },
  publisher: { "@id": `${siteOrigin}/#business` },
  datePublished: "2026-08-08",
  dateModified: "2026-08-08",
  image: locationsArticleImage,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": locationsCanonical,
  },
  about: [
    { "@type": "Place", name: "Tri-Cities, Washington" },
    { "@type": "Thing", name: "Outdoor portrait photography" },
  ],
  spatialCoverage: [
    {
      "@type": "City",
      name: "Richland",
      containedInPlace: { "@type": "State", name: "Washington" },
    },
    { "@type": "City", name: "Kennewick" },
    { "@type": "City", name: "Pasco" },
  ],
};
const locationsBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Journal", item: absoluteUrl("/journal/") },
    {
      "@type": "ListItem",
      position: 3,
      name: "Where to Take Photos in the Tri-Cities",
      item: absoluteUrl(entry.path),
    },
  ],
};
const additionalSchema = isLocationsGuide
  ? [locationsFaqSchema, locationsBreadcrumbSchema]
  : [];
---

<Base
  title={page.title}
  description={page.description}
  settings={settings}
  canonicalPath={entry.path}
  searchVisibility={entry.searchVisibility}
  schemaType={entry.schemaType}
  seoImage={page.hero.image}
  seoImageAlt={page.hero.imageAlt}
  additionalSchema={additionalSchema}
  pageSchemaExtra={isLocationsGuide ? locationsArticleSchemaExtra : undefined}
  loadEditorialMotion={false}
>
  <SiteShell settings={settings} homepage={homepage} currentPath={entry.path}>
    <TinaIsland name="contentPage" wrapper={contentPageWrapper} params={{ path: entry.contentPath }} primary>
      {isLocationsGuide
        ? <LocationsGuidePage page={page} settings={settings} />
        : <ContentPage page={page} settings={settings} />}
    </TinaIsland>
  </SiteShell>
</Base>
