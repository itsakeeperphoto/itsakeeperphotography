---
import Base from "../../layouts/Base.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import ContentPage from "../../components/pages/ContentPage.astro";
import LocationsGuidePage from "../../components/pages/LocationsGuidePage.astro";
import NewbornComparisonPage from "../../components/pages/NewbornComparisonPage.astro";
import SeniorTimingPage from "../../components/pages/SeniorTimingPage.astro";
import SiteShell from "../../components/SiteShell.astro";
import newbornComparisonStylesheet from "../../styles/journal-newborn-comparison-page.css?url";
import seniorTimingStylesheet from "../../styles/journal-senior-timing-page.css?url";
import { getContentPage } from "../../lib/content-pages";
import { journalArticleManifest } from "../../lib/page-manifest";
import { absoluteUrl, siteOrigin } from "../../lib/site-environment";
import { getStaticHomepagePage } from "../../lib/static-content";
import { contentPageWrapper } from "../../lib/tina/wrappers";

export function getStaticPaths() {
  return journalArticleManifest.map((entry) => ({
    params: { slug: entry.path.split("/").filter(Boolean).at(-1) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const page = getContentPage(entry.contentPath);
const shared = getStaticHomepagePage();
const { homepage, settings } = shared.data;
const isLocationsGuide = entry.id === "locations-guide";
const isNewbornComparison = entry.id === "newborn-comparison";
const isSeniorTiming = entry.id === "senior-timing";
const locationsCanonical = absoluteUrl(entry.path);
const locationsArticleImage = new URL(
  page.hero.image || settings.seoImage,
  `${siteOrigin}/`,
).toString();

const locationsQuestions = isLocationsGuide
  ? page.sections.find((section) => section.id === "location-questions")?.items || []
  : [];
const locationsFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: locationsQuestions.map((item) => ({
    "@type": "Question",
    name: item.heading,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.paragraphs?.join(" "),
    },
  })),
};
const locationsArticleSchemaExtra = {
  headline: page.title,
  author: { "@id": `${siteOrigin}/#lisa` },
  publisher: { "@id": `${siteOrigin}/#business` },
  datePublished: "2026-08-08",
  dateModified: "2026-08-08",
  image: locationsArticleImage,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": locationsCanonical,
  },
  about: [
    { "@type": "Place", name: "Tri-Cities, Washington" },
    { "@type": "Thing", name: "Outdoor portrait photography" },
  ],
  spatialCoverage: [
    {
      "@type": "City",
      name: "Richland",
      containedInPlace: { "@type": "State", name: "Washington" },
    },
    { "@type": "City", name: "Kennewick" },
    { "@type": "City", name: "Pasco" },
  ],
};
const locationsBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Journal", item: absoluteUrl("/journal/") },
    {
      "@type": "ListItem",
      position: 3,
      name: "Where to Take Photos in the Tri-Cities",
      item: absoluteUrl(entry.path),
    },
  ],
};

const seniorTimingCanonical = absoluteUrl(entry.path);
const seniorTimingImage = new URL(
  page.hero.image || settings.seoImage,
  `${siteOrigin}/`,
).toString();
const seniorTimingSection = (id: string) =>
  page.sections.find((section) => section.id === id);
const seniorTimingFaqSources = isSeniorTiming
  ? [
      {
        question: page.hero.heading,
        section: seniorTimingSection("the-short-answer"),
      },
      {
        question: seniorTimingSection("when-is-it-too-late")?.heading,
        section: seniorTimingSection("when-is-it-too-late"),
      },
      {
        question: seniorTimingSection("best-time-of-day")?.heading,
        section: seniorTimingSection("best-time-of-day"),
      },
    ]
  : [];
const seniorTimingFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: seniorTimingFaqSources.map(({ question, section }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: {
      "@type": "Answer",
      text: section?.paragraphs?.join(" "),
    },
  })),
};
const seniorTimingArticleSchemaExtra = {
  headline: page.title,
  author: { "@id": `${siteOrigin}/#lisa` },
  publisher: { "@id": `${siteOrigin}/#business` },
  image: seniorTimingImage,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": seniorTimingCanonical,
  },
  about: [
    { "@type": "Thing", name: "Senior pictures" },
    { "@type": "Place", name: "Tri-Cities, Washington" },
  ],
  spatialCoverage: [
    {
      "@type": "City",
      name: "Richland",
      containedInPlace: { "@type": "State", name: "Washington" },
    },
    { "@type": "City", name: "Kennewick" },
    { "@type": "City", name: "Pasco" },
  ],
};
const seniorTimingBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Journal", item: absoluteUrl("/journal/") },
    {
      "@type": "ListItem",
      position: 3,
      name: "When to Take Senior Pictures",
      item: seniorTimingCanonical,
    },
  ],
};

const newbornComparisonCanonical = absoluteUrl(entry.path);
const newbornComparisonImage = new URL(
  page.hero.image || "/uploads/richland-mother-newborn-at-home.jpg",
  `${siteOrigin}/`,
).toString();
const newbornComparisonFaqItems = isNewbornComparison
  ? page.sections.find((section) => section.id === "common-questions")?.items || []
  : [];
const newbornComparisonFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: newbornComparisonFaqItems.map((item) => ({
    "@type": "Question",
    name: item.heading,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.paragraphs?.join(" "),
    },
  })),
};
const newbornComparisonArticleSchemaExtra = {
  headline: page.title,
  author: { "@id": `${siteOrigin}/#lisa` },
  publisher: { "@id": `${siteOrigin}/#business` },
  image: newbornComparisonImage,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": newbornComparisonCanonical,
  },
  about: [
    { "@type": "Thing", name: "Newborn photography" },
    { "@type": "Place", name: "Tri-Cities, Washington" },
  ],
  spatialCoverage: [
    {
      "@type": "City",
      name: "Richland",
      containedInPlace: { "@type": "State", name: "Washington" },
    },
    { "@type": "City", name: "Kennewick" },
    { "@type": "City", name: "Pasco" },
  ],
};
const newbornComparisonBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Journal", item: absoluteUrl("/journal/") },
    {
      "@type": "ListItem",
      position: 3,
      name: "In-Home vs. Studio Newborn Photography",
      item: newbornComparisonCanonical,
    },
  ],
};
const additionalSchema = isLocationsGuide
  ? [locationsFaqSchema, locationsBreadcrumbSchema]
  : isSeniorTiming
    ? [seniorTimingFaqSchema, seniorTimingBreadcrumbSchema]
    : isNewbornComparison
      ? [newbornComparisonFaqSchema, newbornComparisonBreadcrumbSchema]
    : [];
const pageSchemaExtra = isLocationsGuide
  ? locationsArticleSchemaExtra
  : isSeniorTiming
    ? seniorTimingArticleSchemaExtra
    : isNewbornComparison
      ? newbornComparisonArticleSchemaExtra
    : undefined;
const directionContract = isSeniorTiming
  ? "Senior Timing Field Guide: shared EditorialHero; literal verified Senior photography; one asymmetric seasonal contact sheet; ruled practical ledgers; no invented dates, district deadlines, gradients, rounded cards, tape, splatter, badges or shadows."
  : isNewbornComparison
    ? "Newborn Comparison House Archive: shared EditorialHero; verified in-home and outdoor photography; studio context remains typographic; one arched image, ruled comparison rows and no invented dates, studio portfolio, gradients, rounded cards, tape, splatter, badges or shadows."
  : undefined;
---

<Base
  title={page.title}
  description={page.description}
  settings={settings}
  canonicalPath={entry.path}
  searchVisibility={entry.searchVisibility}
  schemaType={entry.schemaType}
  seoImage={page.hero.image}
  seoImageAlt={page.hero.imageAlt}
  additionalSchema={additionalSchema}
  pageSchemaExtra={pageSchemaExtra}
  pageStylesheet={isSeniorTiming
    ? seniorTimingStylesheet
    : isNewbornComparison
      ? newbornComparisonStylesheet
      : undefined}
  directionContract={directionContract}
  loadEditorialMotion={false}
>
  <SiteShell settings={settings} homepage={homepage} currentPath={entry.path}>
    <TinaIsland name="contentPage" wrapper={contentPageWrapper} params={{ path: entry.contentPath }} primary>
      {isLocationsGuide
        ? <LocationsGuidePage page={page} settings={settings} />
        : isSeniorTiming
          ? <SeniorTimingPage page={page} settings={settings} />
          : isNewbornComparison
            ? <NewbornComparisonPage page={page} settings={settings} />
          : <ContentPage page={page} settings={settings} />}
    </TinaIsland>
  </SiteShell>
</Base>
